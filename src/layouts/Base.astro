---
// Page shell: <head>, announcement bar, the one Nav, the page, the one Footer, shared script.
// Slots: default (the page), "head" (extra head tags), "footer" (a page-specific footer), "foot" (scripts after script.js).
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const {
  title,
  description,
  robots,
  canonical,
  nav = 'site',
  navSkin = 'site',
  current,
  footer = 'ticket',
  footerProps = {},
  announce = false,
  bodyAttrs = {},
  appCss = true,
  sharedScript = true,
  fonts = 'https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Newsreader:opsz,wght@6..72,400&display=swap',
} = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  {description && <meta name="description" content={description} />}
  {robots && <meta name="robots" content={robots} />}
  <meta name="theme-color" content="#f6f3f1" />
  {canonical && <link rel="canonical" href={canonical} />}
  <link rel="icon" href="/favicon.ico" sizes="48x48" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href={fonts} rel="stylesheet" />
  {appCss && <link rel="stylesheet" href="/styles.css" />}
  <slot name="head" />
</head>
<body {...bodyAttrs}>
  {announce && (
    <div class="announce" id="announce">
      <div class="announce__inner">
        <p>{announce === 'dev' ? 'Early access is open. API keys are issued by the Pramaan team, with $1.00 starter credit.' : 'Early access is open. Start with $1 of free credit.'}</p>
        <a class="announce__pill" href="#start">{announce === 'dev' ? 'Request a key' : 'Join now'}</a>
        <button class="announce__close" aria-label="Dismiss announcement" data-dismiss="announce">&times;</button>
      </div>
    </div>
  )}
  <Nav variant={nav} skin={navSkin} current={current} />
  <slot />
  {footer === 'ticket' ? <Footer {...footerProps} /> : <slot name="footer" />}
  {sharedScript && <script is:inline src="/script.js"></script>}
  <slot name="foot" />
</body>
</html>

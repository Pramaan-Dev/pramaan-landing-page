---
// The For humans / For agents pill, top right. script.js switches [data-human-view] and [data-agent-view].
---
<div class="view-bar">
  <div class="view-toggle" role="group" aria-label="View">
    <button type="button" data-view="human" aria-pressed="true">For humans</button>
    <button type="button" data-view="agent" aria-pressed="false">For agents</button>
  </div>
</div>

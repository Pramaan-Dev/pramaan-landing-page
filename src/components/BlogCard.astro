---
// Blog card: the post's share image (public/og/blog/<id>.png) as the cover, then date, title, summary, author.
import { fmtDate, minutes } from '../lib/blog.mjs';
const { p, big = false } = Astro.props;
---
<a class={`pcard bl-card${big ? ' pcard--big' : ''}`} href={`/blog/${p.id}`}>
  <img class="bl-og" src={`/og/blog/${p.id}.png`} alt="" width="1200" height="630" loading={big ? 'eager' : 'lazy'} />
  <span class="pcard__meta">{fmtDate(p.data.date)} | {minutes(p)} min read</span>
  <b class="pcard__title">{p.data.title}</b>
  <span class="pcard__sub bl-clamp">{p.data.description}</span>
  <span class="bl-by"><span class="bl-av bl-av--sm">P</span>{p.data.author}</span>
</a>

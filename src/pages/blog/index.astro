---
import Base from '../../layouts/Base.astro';
import { posts, coverOf, metaLine } from '../../lib/blog.mjs';
const list = await posts();
const big = list.slice(0, 2), rest = list.slice(2);
---
<Base title="Blog | Pramaan" description="Notes from the Pramaan team." canonical="https://www.pramaan.dev/blog" footerProps={{ variant: 'catalogue', count: '3510', countLabel: 'Superpowers', eyebrow: 'find', tools: ['ui-builder', 'ui-inspiration'] }}>
  <Fragment slot="head">
    <link rel="stylesheet" href="/catalogue.css" />
    <link rel="alternate" type="application/rss+xml" title="Pramaan blog" href="/blog/rss.xml" />
    <link rel="stylesheet" href="/components/ticket-stub-footer.css" />
    <script is:inline src="/components/ticket-stub-footer.js" defer></script>
  </Fragment>
  <main>
    <section class="cat-hero">
      <div class="container cat-hero__inner">
        <h1 class="display">Blog</h1>
        <p class="lead">Notes from the Pramaan team: what we ship, how agents use it, and what we learn along the way.</p>
      </div>
    </section>
    <div class="container">
      <div class="posts">
        {list.length === 0 && <p class="caption">No posts yet.</p>}
        {big.length > 0 && (
          <div class="posts__big">
            {big.map((p) => (
              <a class="pcard pcard--big" href={`/blog/${p.id}`}>
                <div class={`pcard__cover cover cover--${coverOf(p.id)}`} aria-hidden="true"></div>
                <span class="pcard__meta">{metaLine(p)}</span>
                <b class="pcard__title">{p.data.title}</b>
                <span class="pcard__sub">{p.data.description}</span>
                <span class="pcard__more">Read more</span>
              </a>
            ))}
          </div>
        )}
        {rest.length > 0 && (
          <div class="posts__grid">
            {rest.map((p) => (
              <a class="pcard" href={`/blog/${p.id}`}>
                <div class={`pcard__cover cover cover--${coverOf(p.id)}`} aria-hidden="true"></div>
                <span class="pcard__meta">{metaLine(p)}</span>
                <b class="pcard__title">{p.data.title}</b>
                <span class="pcard__more">Read more</span>
              </a>
            ))}
          </div>
        )}
      </div>
    </div>
  </main>
</Base>

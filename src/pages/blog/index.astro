---
// Blog hub (ColdIQ's structure in Pramaan's look): heading, section links, featured post with the next three,
// one row per section, dark closing band. Rows with no posts are left out.
import Base from '../../layouts/Base.astro';
import BlogCard from '../../components/BlogCard.astro';
import BlogBand from '../../components/BlogBand.astro';
import Newsletter from '../../components/Newsletter.astro';
import { posts, fmtDate } from '../../lib/blog.mjs';
import { allResources, TYPE, fmtDay } from '../../lib/resources.mjs';
const list = await posts();
const others = (await allResources()).filter((r) => r.type !== 'blog');
const [lead, ...rest] = list;
const forAud = (a) => list.filter((p) => p.data.audience === a || p.data.audience === 'everyone');
const ROWS = [
  { id: 'guides', name: 'Guides', blurb: 'Step by step, start to finish.', items: list.filter((p) => p.data.og.steps) },
  { id: 'business', name: 'For business teams', blurb: 'Jobs you can hand to an agent, no code needed.', items: forAud('business') },
  { id: 'developers', name: 'For developers', blurb: 'MCP, SDK and HTTP: build on Pramaan.', items: forAud('developers') },
  { id: 'ebooks', name: 'Ebooks and reports', blurb: 'Longer reads to keep and share.', res: others.filter((r) => r.type !== 'event'), unit: ['item', 'items'] },
  { id: 'events', name: 'Events', blurb: 'Live demos, meetups and replays.', res: others.filter((r) => r.type === 'event'), unit: ['event', 'events'] },
].map((r) => ({ unit: ['article', 'articles'], ...r, n: (r.items ?? r.res).length })).filter((r) => r.n);
---
<Base title="Blog | Pramaan" description="How-tos, launches and notes from the Pramaan team on handing real work to AI agents." canonical="https://www.pramaan.dev/blog" footerProps={{ variant: 'catalogue', countLabel: 'Superpowers', eyebrow: 'find', tools: ['ui-builder', 'ui-inspiration'] }}>
  <Fragment slot="head">
    <link rel="stylesheet" href="/catalogue.css" />
    <link rel="stylesheet" href="/blog.css" />
    <link rel="alternate" type="application/rss+xml" title="Pramaan blog" href="/blog/rss.xml" />
    <link rel="stylesheet" href="/components/ticket-stub-footer.css" />
    <script is:inline src="/components/ticket-stub-footer.js" defer></script>
  </Fragment>
  <main>
    <div class="container">
      <section class="bl-hubhead">
        <span class="eyebrow bl-bracket">Blog</span>
        <h1>Pramaan's <em>Get Work Done</em> Hub</h1>
        <p>How-tos, launches and notes on handing real work to AI agents.</p>
      </section>
      {list.length === 0 ? <p class="caption" style="text-align:center;padding:48px 0">No posts yet.</p> : <>
        {ROWS.length > 1 && <nav class="bl-seg" aria-label="Sections"><a href="#top">All</a>{ROWS.map((r) => <a href={`#${r.id}`}>{r.name}</a>)}</nav>}
        <section class="bl-feat" id="top">
          <BlogCard p={lead} big />
          <div class="bl-side">
            <Newsletter />
            {rest.slice(0, 3).map((p) => (
              <a class="bl-mini" href={`/blog/${p.id}`}>
                <img class="bl-og" src={`/og/blog/${p.id}.png`} alt="" width="1200" height="630" loading="lazy" />
                <span><span class="pcard__meta">{fmtDate(p.data.date)}</span><b>{p.data.title}</b><span class="bl-by" style="margin-top:8px"><span class="bl-av bl-av--sm">P</span>{p.data.author}</span></span>
              </a>
            ))}
          </div>
        </section>
        {ROWS.map((r) => (
          <section class="bl-row" id={r.id}>
            <div class="bl-row__head">
              <div><span class="eyebrow bl-bracket">{r.n} {r.unit[r.n === 1 ? 0 : 1]}</span><h2 class="bl-h2">{r.name}</h2><p>{r.blurb}</p></div>
            </div>
            <div class="posts__grid bl-grid">{r.items ? r.items.map((p) => <BlogCard p={p} />) : r.res.map((x) => (
              <a class="pcard bl-card" href={x.href}>
                <img class="bl-og" src={x.og} alt="" width="1200" height="630" loading="lazy" />
                <span class="pcard__meta">{TYPE[x.type]} | {x.note && `${x.note} | `}{fmtDay(x.date)}</span>
                <b class="pcard__title">{x.title}</b>
                <span class="pcard__sub bl-clamp">{x.description}</span>
              </a>
            ))}</div>
          </section>
        ))}
      </>}
    </div>
    <BlogBand />
  </main>
</Base>

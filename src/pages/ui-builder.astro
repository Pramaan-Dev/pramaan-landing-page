function wireDesign(){
  const ta = $('#design');
  $('#applyDesign').onclick = applyDesign;
  $('#pickFile').onclick = () => $('#designFile').click();
  $('#designFile').onchange = e => readDesignFile(e.target.files[0]);
  const clear = $('#clearDesign');
  if (clear) clear.onclick = () => { lastUndo = JSON.stringify(snapshot()); lastUndoWhat = 'removing your design file';
    Object.assign(S, S.beforeImport || {}, {imported:null, importNote:'', beforeImport:null, edits:null, sources:null, fontNote:''}); render();
    notify('Design removed', 'Back to the look you had before importing.', 'info', [['Undo', undoDesign]], {key:'design'}); };
  ta.ondragover = e => { e.preventDefault(); ta.classList.add('drag'); };
  ta.ondragleave = () => ta.classList.remove('drag');
  ta.ondrop = e => { e.preventDefault(); ta.classList.remove('drag'); readDesignFile(e.dataTransfer.files[0]); };
  document.querySelectorAll('[data-sample]').forEach(b => b.onclick = () => { S.importText = SAMPLES[b.dataset.sample]; applyDesign(); });
}

/* ---------- dock (applies to every card at once) ---------- */

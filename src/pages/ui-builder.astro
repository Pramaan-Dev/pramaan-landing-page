/* ---------- render ---------- */
const BASE = {
  light:{page:'#f4f4f5', card:'#ffffff', text:'#09090b', muted:'#71717a', line:'#e4e4e7', soft:'#f4f4f5', danger:'#dc2626', ok:'#16a34a'},
  dark: {page:'#0b0b0d', card:'#141416', text:'#fafafa', muted:'#a1a1aa', line:'#27272a', soft:'#1f1f23', danger:'#f87171', ok:'#4ade80'},
};
/** The full resolved palette for one mode: defaults, then the imported design, then a readable primary. */
function theme(mode){
  const pal = (S.imported && S.imported[mode]) || {};
  // Defaults follow the page the file gives, not the mode label: a dark page under "light" (Refero mislabels some)
  // gets dark defaults tinted from that page, so white text never lands on white default cards.
  let base = BASE[mode];
  if (pal.bg && (lum(pal.bg) < .18) !== (mode === 'dark')) base = lum(pal.bg) < .18
    ? {...BASE.dark, card:mix(pal.bg, '#ffffff', .06), soft:mix(pal.bg, '#ffffff', .1), line:mix(pal.bg, '#ffffff', .16)} : BASE.light;
  const t = {...base};
  for (const k of ['card','text','muted','line','soft','danger','ok']) if (pal[k]) t[k] = pal[k];
  if (pal.bg) t.page = pal.bg;
  let p = pal.primary || S.primary;
  // No primary for this mode and the cards are dark: a near-black brand (Vercel, Neutral) would vanish on them.
  if (!pal.primary && lum(t.card) < .18) { const ch = hex2rgb(p);
    // a grey/black brand flips to near-white (as shadcn's neutral theme does); a coloured one is lightened
    if (Math.max(...ch) - Math.min(...ch) < 16 && contrast(p, t.card) < 4.5) p = pal.text || '#fafafa';
    for (let i = 0; i < 20 && contrast(p, t.card) < 4.5; i++) p = '#' + hex2rgb(p).map(v => Math.round(v + (255 - v) * .15).toString(16).padStart(2,'0')).join(''); }
  t.primary = p; t.primaryFg = pal.primaryFg || fgFor(p);
  // the user's own edits from the colour table win over everything
  const ed = (S.edits && S.edits[mode]) || {};
  Object.assign(t, ed);
  if (ed.primary && !ed.primaryFg) t.primaryFg = fgFor(ed.primary);
  return t;
}

/** One colour change from the table or a Fix button. Light primary stays in S.primary so the Look picker matches. */
function setSlot(mode, k, v){
  if (k === 'primary' && mode === 'light') { S.primary = v; if (S.sources?.light) delete S.sources.light.primary;
    if (S.imported) delete S.imported.light.primaryFg; S.preset = 'custom'; return; }
  S.edits = S.edits || {light:{}, dark:{}}; S.edits[mode][k] = v; S.preset = 'custom';
}

/** Where a colour in the table came from, in plain words. */
function slotSource(mode, k){
  if (S.edits?.[mode]?.[k]) return 'Edited by you';
  const src = S.sources?.[mode]?.[k];
  if (src) return 'From file: ' + src;
  if (k === 'primary') return mode === 'light' ? (S.imported ? 'From file' : S.preset === 'custom' ? 'Picked by you' : 'From preset') : 'Auto: readable on dark cards';
  if (k === 'primaryFg') return 'Auto: readable on the primary colour';
  return S.imported ? 'Default (not in your file)' : 'Default';
}


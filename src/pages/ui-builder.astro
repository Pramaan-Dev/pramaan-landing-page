/** The chosen font's Google Fonts stylesheet, when it comes from Google (the five built-ins, or one picked or imported from there). */
const gfHref = () => { const n = fontName(), st = document.getElementById('gf-' + n.replace(/\W/g,''));
  return FONTS.some(f => f[1] === n) || st?.textContent ? `https://fonts.googleapis.com/css2?family=${encodeURIComponent(n).replace(/%20/g,'+')}:wght@400;500;600;700&display=swap` : null; };
/** Exports name the font; this also loads it, so the pasted result looks like the preview. */
function withFont(fmt, out){
  const u = gfHref(), n = fontName(); if (!u) return out;
  const imp = `@import url("${u}");`, line1 = s => s.replace(/^([^\n]*\n)/, `$1${imp}\n`);
  if (fmt === 'shadcn' || fmt === 'Tailwind v4') return out.replace('@import "tailwindcss";', `${imp}\n@import "tailwindcss";`);   // must come before Tailwind
  if (fmt === 'CSS') return `${imp}\n\n${out}`;
  if (fmt === 'SCSS') return line1(out);
  if (['MUI','Mantine','Chakra','Tailwind v3'].includes(fmt)) return out.replace(/^([^\n]*\n)/, `$1// Font: load ${n} in your HTML <head>: <link rel="stylesheet" href="${u}">\n`);
  if (['React Native','SwiftUI','Compose'].includes(fmt)) return out.replace(/^([^\n]*\n)/, `$1// Font: ${n}, free from https://fonts.google.com/specimen/${encodeURIComponent(n).replace(/%20/g,'+')}\n`);
  if (fmt === 'DESIGN.md') return out.replace('- **Substitute:** Inter\n', `- **Load from:** ${u} (free on Google Fonts)\n- **Substitute:** Inter\n`);
  if (fmt === 'Figma') return `${out}\nfont/source       ${u}`;
  return out;
}
// Get code feedback: the copied state and its message stay until the content changes (tab switch, reopen) or Copy is pressed again
function gcReset(){
  const b = $('#copy'), s = $('#exStatus');
  b.removeAttribute('data-state'); b.textContent = 'Copy';
  s.textContent = ''; s.classList.remove('gc-err'); s.setAttribute('role', 'status'); s.setAttribute('aria-live', 'polite');
}
function gcSay(msg, bad){
  const s = $('#exStatus');
  s.classList.toggle('gc-err', !!bad); s.setAttribute('role', bad ? 'alert' : 'status'); s.setAttribute('aria-live', bad ? 'assertive' : 'polite');
  requestAnimationFrame(() => { s.textContent = msg; });   // empty first, then set on the next frame, so a repeated copy is announced again
}

/* ---------- readability check: every text/background pair, WCAG AA ---------- */
const CHECKS = [
  ['Text on page', 'text', 'page', 4.5], ['Text on cards', 'text', 'card', 4.5], ['Muted text on cards', 'muted', 'card', 4.5],
  ['Button text', 'primaryFg', 'primary', 4.5], ['Primary on cards', 'primary', 'card', 3],
  ['Error text on cards', 'danger', 'card', 4.5], ['Success on cards', 'ok', 'card', 3],
];
// The readability list starts closed (the red dot and "6 of 7 pass" flag a problem) and keeps the visitor's open/closed choice across redraws
let guardOpen = false;
let geoOpen = false;   // the shape check keeps its own open/closed choice
$('#guard').addEventListener('toggle', e => { if (e.target.classList.contains('geo-read')) geoOpen = e.target.open; else guardOpen = e.target.open; }, true);   // toggle does not bubble: listen in the capture phase
function drawGuard(){
  const T = theme(S.mode), res = CHECKS.map(([label, fg, bg, min], i) => ({i, label, min, cr:contrast(T[fg], T[bg])}));
  const bad = res.filter(r => r.cr < r.min), dot = ok => `<i style="background:${ok ? 'var(--c-ok)' : 'var(--c-bad)'}"></i>`;
  // the Undo of the last big change (a design, Surprise me, Start over) lives here until it is used or a style is chosen
  const undo = lastUndo ? `<button type="button" class="sp-link geo-undo" id="undoLast">Undo ${esc(lastUndoWhat || 'the last change')}</button>` : '';
  $('#guard').innerHTML = undo + `<details class="read"${guardOpen ? ' open' : ''}><summary>${dot(!bad.length)}Readability (${S.mode}): ${res.length - bad.length} of ${res.length} pass</summary>`
    + `<div class="list">${res.map(r => { const plans = r.cr < r.min ? fixPlans(CHECKS[r.i]) : [];
      return `<div class="ck">${dot(r.cr >= r.min)}<span>${r.label} · ${r.cr.toFixed(1)}:1${plans.length > 1 ? ` (needs ${r.min})` : ''}</span>`
        + `${plans.length === 1 ? `<button data-fix="${r.i}">Fix</button>` : ''}</div>`
        + (plans.length > 1 ? `<div class="fx2">${plans.map((p, j) => `<button data-fix="${r.i}" data-plan="${j}" title="${p.label}: ${p.slot === 'primary' ? 'button' : 'text'} becomes ${p.value}, ${p.note}"><span class="fxs" style="background:${p.bg};color:${p.fg}">Aa</span>`
          + `<span>${p.label}<small>${p.note} · ${p.cr.toFixed(1)}:1</small></span></button>`).join('')}</div>` : ''); }).join('')}`
    + `${bad.length > 1 ? `<div class="ck"><span></span><button data-fixall>Fix all</button></div>` : ''}</div></details>` + geoHtml();
}
// Fix checks every background the colour sits on (text is on both page and cards), so one fix never breaks another.
// If no single colour can pass on all of them, it moves the failing background toward the other one instead.
const stepTo = (c, to, k = .1) => '#' + hex2rgb(c).map((v, i) => Math.round(v + (hex2rgb(to)[i] - v) * k).toString(16).padStart(2,'0')).join('');
// Ways to make one failing check pass, best first. Each is {slot, value, ...} and is only offered if it keeps
// every other check on that colour passing. Button text gets two: move the button colour and keep the text colour
// the file chose, or keep the brand colour exactly and change the text. Fix all takes the first.
function fixPlans([, fg, bg, min]){
  const T = theme(S.mode); if (contrast(T[fg], T[bg]) >= min) return [];
  const ok = (slot, c) => CHECKS.every(([, f, b, m]) => f !== slot && b !== slot || contrast(f === slot ? c : T[f], b === slot ? c : T[b]) >= m);
  const plans = [];
  if (bg === 'primary') {   // step the button away from its text: darker under light text, lighter under dark text
    let c = T.primary; const dark = lum(T.primaryFg) > .5;
    for (let i = 0; i < 60 && !ok('primary', c); i++) c = stepTo(c, dark ? '#000000' : '#ffffff', .04);
    if (ok('primary', c)) plans.push({slot:'primary', value:c, pin:T.primaryFg, bg:c, fg:T.primaryFg, cr:contrast(T.primaryFg, c),
      label: dark ? 'Darken button' : 'Lighten button', note:'keeps your text colour'});
  }
  // moving the brand colour for links may leave its button text unreadable; that text is then re-picked (applyPlan)
  const okFg = c => fg === 'primary' ? CHECKS.every(([, f, b, m]) => f !== 'primary' || contrast(c, T[b]) >= m) : ok(fg, c);
  for (const to of ['#000000', '#ffffff']) {
    let c = T[fg];
    // button text goes straight to near-black or white: a grey label on a coloured button looks broken
    if (fg === 'primaryFg') c = to === '#000000' ? '#111111' : '#ffffff';
    for (let i = 0; i < 60 && !okFg(c); i++) c = stepTo(c, to);
    if (okFg(c)) { plans.push({slot:fg, value:c, bg:T[bg], fg:c, cr:contrast(c, T[bg]),
      label: lum(c) > .5 ? 'Light text' : 'Dark text', note:'keeps your brand colour'}); break; }
  }
  // a pale button (yellow, mint) would have to turn murky to carry light text: then changing the text is the smaller change
  const far = (a, b) => Math.hypot(...hex2rgb(a).map((v, i) => v - hex2rgb(b)[i])) > 60;
  if (plans.length === 2 && plans[0].pin && far(plans[0].value, T.primary)) plans.reverse();
  if (plans.length) return plans;
  // no colour of the text passes on every background it sits on: move the failing background toward the other one
  const other = CHECKS.filter(c => c[1] === fg).map(p => p[2]).find(b => b !== bg);
  let b = T[bg], to = other ? T[other] : (contrast(T[fg], '#000000') > contrast(T[fg], '#ffffff') ? '#ffffff' : '#000000');
  for (let i = 0; i < 60 && contrast(T[fg], b) < min; i++) b = stepTo(b, to);
  if (contrast(T[fg], b) < min) { to = contrast(T[fg], '#000000') > contrast(T[fg], '#ffffff') ? '#000000' : '#ffffff';
    for (let i = 0; i < 60 && contrast(T[fg], b) < min; i++) b = stepTo(b, to); }
  return [{slot:bg, value:b}];
}
function applyPlan(p){
  if (!p) return;
  // a moved button colour is kept only as an edit: theme() applies edits last, so the automatic dark-card lift can't
  // undo it, and Undo on the colour row brings the original back
  if (p.slot === 'primary') { S.edits = S.edits || {light:{}, dark:{}}; S.edits[S.mode].primary = p.value; S.preset = 'custom'; }
  else setSlot(S.mode, p.slot, p.value);
  // keep the text colour the button had; otherwise theme() would recompute it from the new button colour
  if (p.pin) { S.edits = S.edits || {light:{}, dark:{}}; S.edits[S.mode].primaryFg = p.pin; }
  else if (p.slot === 'primary') { const T = theme(S.mode);
    if (contrast(T.primaryFg, T.primary) < 4.5) { S.edits = S.edits || {light:{}, dark:{}}; S.edits[S.mode].primaryFg = fgFor(T.primary); } }
}
const fixCheck = (c, j = 0) => applyPlan(fixPlans(c)[j]);
$('#guard').addEventListener('click', e => { const b = e.target.closest('[data-fix],[data-fixall]'); if (!b) return; e.preventDefault();
  // one fix can move a colour another check uses (links move the button colour), so go round until nothing fails
  if ('fixall' in b.dataset) for (let n = 0; n < 4 && CHECKS.some(c => fixPlans(c).length); n++) for (const c of CHECKS) fixCheck(c);
  else fixCheck(CHECKS[Number(b.dataset.fix)], Number(b.dataset.plan || 0));
  render(); });

/* ---------- shape check: measured on the painted preview, beside the readability check ----------
   Three questions: do cards keep sane corners, is anything tall an oval, is anything cut off by a rounded outline.
   Web previews only (the app screens have their own fixed shapes). The result is cached on everything that changes shape,
   so dragging a colour does not measure again. */
const GEO_LABELS = ['Cards keep their corners', 'Buttons and tags are not ovals', 'Nothing is cut off'];
const GEO_CORNERS = ['borderTopLeftRadius', 'borderTopRightRadius', 'borderBottomRightRadius', 'borderBottomLeftRadius'];
let geoCache = {key:'', res:null};
const geoKey = st => JSON.stringify([S.radius, S.density, S.font, S.device, S.mode, S.state, S.locale, S.tone, S.style,
  ['--r', '--rc', '--ri', '--rt', '--rb'].map(k => st.style.getPropertyValue(k))]);   // the radius variables too, so a forced one is measured
function geoMeasure(st){
  const px = v => /^[\d.]+px/.test(v) ? parseFloat(v) : 0;   // only pixel radii can run away; a percentage is a deliberate shape
  let cards = true, ovals = true, cut = true;
  st.classList.add('geo-measure');   // no transitions while measuring: read the final radii, not a transition's first frame
  try {
    for (const el of st.querySelectorAll('.card,.site,.foot2,.modal .box')) { const b = el.getBoundingClientRect(); if (!b.width) continue;
      const r = px(getComputedStyle(el).borderTopLeftRadius);
      if (r > R_CARD_MAX + .01 || r * 2 > Math.min(b.width, b.height) + .5) cards = false; }
    for (const el of st.querySelectorAll('*')) { const b = el.getBoundingClientRect(); if (b.height <= 56) continue;
      const cs = getComputedStyle(el);
      if (GEO_CORNERS.some(p => { const r = px(cs[p]); return r > R_CARD_MAX && r * 2 >= b.height - .5; })) { ovals = false; break; } }
    // the nearest corner of the element against that corner's arc: a point inside the corner square but beyond the arc is cut off
    const clipped = (el, box) => { if (!el || !box) return false;
      const r = el.getBoundingClientRect(), c = box.getBoundingClientRect(), cs = getComputedStyle(box); if (!r.width || !c.width) return false;
      const lim = Math.min(c.width, c.height) / 2;
      return [[r.left, r.top, c.left, c.top, 1, 1], [r.right, r.top, c.right, c.top, -1, 1], [r.right, r.bottom, c.right, c.bottom, -1, -1], [r.left, r.bottom, c.left, c.bottom, 1, -1]]
        .some(([x, y, bx, by, sx, sy], i) => { const R = Math.min(px(cs[GEO_CORNERS[i]]), lim); if (!R) return false;
          const dx = (x - bx) * sx, dy = (y - by) * sy;   // how far in from the box corner, along each edge
          return dx < R && dy < R && Math.hypot(R - dx, R - dy) > R + .5; }); };
    const site = st.querySelector('.site');
    if (clipped(st.querySelector('.links a'), site) || clipped(st.querySelector('.brand'), site)) cut = false;
    for (const h of st.querySelectorAll('.ch h4')) if (clipped(h, h.closest('.card, .modal .box'))) { cut = false; break; }
  } finally { st.classList.remove('geo-measure'); }
  return [cards, ovals, cut].map((ok, i) => ({label:GEO_LABELS[i], ok}));
}
function geoResult(){
  const st = $('#stage');
  if (!st || (S.device !== 'desktop' && S.device !== 'mobile') || !st.offsetWidth) return null;
  const key = geoKey(st);
  if (geoCache.key !== key) geoCache = {key, res:geoMeasure(st)};
  return geoCache.res;
}
function geoHtml(){
  const res = geoResult(); if (!res) return '';
  const ok = res.filter(r => r.ok).length, dot = good => `<i style="background:${good ? 'var(--c-ok)' : 'var(--c-bad)'}"></i>`;
  return `<details class="read geo-read"${geoOpen ? ' open' : ''}><summary>${dot(ok === res.length)}Shapes: ${ok} of ${res.length} fit</summary><div class="list">`
    + res.map(r => `<div class="ck">${dot(r.ok)}<span>${r.label}</span>${r.ok ? '' : '<button type="button" data-geofix>Fix</button>'}</div>`).join('') + `</div></details>`;
}
/** Fix for a failing shape: back to Full at most, and the design's own container radii above their caps dropped. */
function geoFix(){
  const was = S.radius; S.radius = Math.min(S.radius, R_FULL);
  if (S.style) { if (S.style.base === was) S.style.base = S.radius;
    const R = S.style.radius; if (R) { for (const k of ['card', 'input']) if (R[k] > R_CARD_MAX) delete R[k];
      for (const k of ['btn', 'tag']) if (R[k] > R_CARD_MAX && R[k] < 100) delete R[k]; } }

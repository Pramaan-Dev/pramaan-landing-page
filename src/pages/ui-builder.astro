  for (let i = G.order.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); [G.order[i], G.order[j]] = [G.order[j], G.order[i]]; }
  G.n = 60; showGrid(); drawGallery(); $('#gal').showModal(); $('#galGrid').scrollTop = 0; $('#galQ').focus();
}
function showGrid(){ $('#galDetail').hidden = true; $('#galGrid').hidden = false; $('.gbar').hidden = false; $('#galFil').hidden = false; }
// Detail view: the site's full page as a scrollable image, its labels and colours, then Apply

const AC_FMT = n => n.toLocaleString('en-US');
const AC_CHART_LABEL = `Bar chart of API calls over the last 14 days, ${AC_FMT(AC_TOTAL)} in total. Calls dip every weekend, and weekday volume steps up about 40% after SDK 2.0 shipped.`;
const acChart = () => `<div class="ac-chart" role="img" aria-label="${AC_CHART_LABEL}">

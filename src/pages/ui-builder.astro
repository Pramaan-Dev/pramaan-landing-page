$('#copy').onclick = async () => {
  const btn = $('#copy'), out = $('#exOut'), text = out.textContent;
  gcReset();
  let ok = false;
  try { if (navigator.clipboard && navigator.clipboard.writeText) { await navigator.clipboard.writeText(text); ok = true; } } catch(e){}
  if (!ok) {   // no clipboard API, or it refused: select the code and use the legacy copy command
    try { const r = document.createRange(), sel = getSelection(); r.selectNodeContents(out); sel.removeAllRanges(); sel.addRange(r); ok = document.execCommand('copy'); } catch(e){}
  }

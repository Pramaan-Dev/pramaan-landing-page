---
import Base from '../layouts/Base.astro';
---
<Base title={"UI builder | Pramaan"} description={"Free UI builder: pick a colour, font and corner style, or paste your own design file. See it on a live sample site, share it as a link and copy the code."} robots="noindex" nav="site" navSkin="builder" current="ui-builder" appCss={false} sharedScript={false} fonts={"https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Inter:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,400;9..144,600&family=JetBrains+Mono:wght@400;500;600&family=Newsreader:opsz,wght@6..72,400&family=Nunito:wght@400;600;800&display=swap"} footerProps={{"variant":"tool","count":"3510","countLabel":"Superpowers","eyebrow":"find","tools":["ui-inspiration"]}}>
<Fragment slot="head">
<!-- Newsreader and JetBrains Mono are the website's fonts; the rest are the preview's font choices. -->

<link rel="stylesheet" href="/components/ticket-stub-footer.css">
<script is:inline src="/components/ticket-stub-footer.js" defer></script>
<style is:inline>
/* ---------- Builder chrome: the website's look (parchment, serif headings, mono UI; styles.css) ----------
   Only the builder's own frame uses these. The preview inside .stage is the user's design.
   styles.css is not loaded: its bare element rules would leak into the preview. */
:root{
  /* website tokens, also read by the footer */
  --color-parchment:#f6f3f1; --color-lake-blue:#2b59d1; --color-periwinkle-mist:#cfdaf5; --color-coral:#ff9473; --color-gold:#ecda98;
  --color-off-black:#242424; --color-ink:#000; --color-graphite:#4e4d4d; --color-smoke:#797776; --color-ash:#cecac8;
  --font-mono:'ABC Diatype Mono','JetBrains Mono',ui-monospace,SFMono-Regular,Menlo,monospace;
  --font-serif:'Untitled Serif','Newsreader',Georgia,'Times New Roman',serif;
  --font-sans:'Untitled Sans','Inter',system-ui,-apple-system,'Segoe UI',sans-serif;   /* same stack as public/styles.css */
  --page-max-width:1432px; --gutter:40px;
  --bg:#f6f3f1; --blob-dark:transparent; --blob-light:transparent;
  --glass:rgba(255,255,255,.55); --glass-strong:#fff; --glass-edge:#cecac8; --glass-shadow:none;
  --card-top:#fff; --card-bottom:#fbfaf9; --card-edge:#cecac8; --card-shadow:none;
  --btn-glass:transparent; --btn-glass-hover:rgba(36,36,36,.07); --btn-edge:#242424; --btn-shadow:none;
  --surface:rgba(255,255,255,.55); --surface-sunk:#efebe8; --line:#cecac8; --line-soft:rgba(36,36,36,.08);
  --fg:#242424; --fg-2:#4e4d4d; --fg-3:#797776; --inverse:#242424; --inverse-solid:#242424; --on-inverse:#fff;
  --thread:#242424; --thread-solid:#000; --on-thread:#fff; --thread-glow:transparent; --thread-edge:transparent;
  --focus:#2b59d1; --needs:#8a5300; --done:#116b33; --blocked:#b91c1c;
  --pane:rgba(246,243,241,.97);   /* dialogs and pop-ups */
  --serif:var(--font-serif); --sans:var(--font-sans); --mono:var(--font-mono);
  /* type roles for the builder's own frame (the preview is the user's design). Sans for words, serif for titles, mono only for values (hex, px, token names, code).
     Weights: 400 text, 500 labels and the selected state, 600 a notice title. Tracking: 0 on sans and mono, -.01em on the 17px serif, -.02em on 21-22px serif, +.04em on the one uppercase button. */
  --t-micro:11px; --t-meta:12px; --t-ui:13px; --t-body:14px; --t-title:17px; --t-dialog:21px; --t-bar:22px; --t-code:13px;
  --r-island:24px; --r-card:16px; --r-ctl:12px; --r-pill:9999px; --gap:12px; --blur:12px; --blur-btn:0px;
  /* names the builder's styles already use, pointed at the glass tokens */
  --c-bg:var(--glass-strong); --c-panel:var(--glass); --c-inset:var(--surface-sunk); --c-line:var(--line); --c-text:var(--fg);
  --c-muted:var(--fg-3); --c-hover:var(--btn-glass-hover); --c-pri:var(--inverse-solid); --c-pri-fg:var(--on-inverse);
  --c-ok:var(--done); --c-bad:var(--blocked);
  color-scheme:light;
}
*{box-sizing:border-box}
html{background:var(--bg);scroll-padding-top:96px} /* keep keyboard focus clear of the 80px sticky nav */
body{margin:0;background:transparent;color:var(--fg);font:400 var(--t-body)/1.5 var(--sans);letter-spacing:0;-webkit-font-smoothing:antialiased}
/* ---------- Website header and intro (class names prefixed: the preview owns .nav, .logo, .btn, .tag) ---------- */
.site-wrap{width:100%;max-width:var(--page-max-width);margin:0 auto;padding:0 var(--gutter)}
.site-nav{position:sticky;top:0;z-index:20;background:rgba(246,243,241,.88);-webkit-backdrop-filter:blur(12px);backdrop-filter:blur(12px)}
.site-nav__inner{height:80px;display:flex;align-items:center;gap:40px}
.site-logo{display:inline-flex;align-items:center;gap:10px;color:var(--color-off-black);text-decoration:none}
.site-logo__mark{width:32px;height:32px;background:url(logo.svg) center/contain no-repeat;flex:none}
.site-logo__word{font-family:var(--font-serif);font-size:28px;letter-spacing:-.02em;line-height:1}
.site-nav__links{display:flex;gap:32px;margin-right:auto}
.site-nav__links a{font-size:18px;text-transform:uppercase;letter-spacing:-.022em;line-height:1.2;color:var(--color-off-black);text-decoration:none;transition:color .2s}
.site-nav__links a:hover{color:var(--color-smoke)} .site-nav__links a{white-space:nowrap}
.site-nav__actions{display:flex;gap:12px}
.site-btn{display:inline-flex;align-items:center;height:48px;padding:16px 32px;border-radius:100px;border:1px solid transparent;font-size:14px;text-transform:uppercase;letter-spacing:-.02em;line-height:1;white-space:nowrap;text-decoration:none;transition:background-color .2s,color .2s,transform .2s}
.site-btn:hover{transform:translateY(-1px)}
.site-btn--black{background:var(--color-off-black);color:#fff} .site-btn--black:hover{background:var(--color-ink)}
.site-btn--ghost{border-color:var(--color-off-black);color:var(--color-off-black)} .site-btn--ghost:hover{background:var(--color-off-black);color:var(--color-parchment)}
.site-nav__toggle{display:none;background:none;border:0;width:40px;height:40px;margin-left:auto;position:relative;cursor:pointer}
.site-nav__toggle span{position:absolute;left:8px;right:8px;height:1.5px;background:var(--color-off-black);transition:transform .2s}
.site-nav__toggle span:first-child{top:15px} .site-nav__toggle span:last-child{top:24px}
.nav-open .site-nav__toggle span:first-child{transform:translateY(4.5px) rotate(45deg)}
.nav-open .site-nav__toggle span:last-child{transform:translateY(-4.5px) rotate(-45deg)}
.uib-hero{padding-top:56px;padding-bottom:12px}
.uib-tag{display:inline-flex;align-items:center;gap:8px;padding:6px 14px;border:1px solid var(--color-off-black);border-radius:100px;font:500 var(--t-meta)/1.2 var(--sans);text-transform:none;letter-spacing:0}
.uib-tag i{width:8px;height:8px;border-radius:50%;background:var(--color-coral)}
.uib-hero h1{margin:20px 0 16px;font:400 64px/1.1 var(--font-serif);letter-spacing:-.02em;color:var(--color-off-black)}
.uib-hero p{margin:0;max-width:760px;font-size:20px;line-height:1.5;letter-spacing:-.01em;color:var(--color-graphite)}
/* Resources menu: same as styles.css .navres (not loaded here) */
.navres{position:relative}
.navres summary{list-style:none;cursor:pointer;display:inline-flex;align-items:center;gap:8px;font-size:18px;text-transform:uppercase;letter-spacing:-.022em;line-height:1.2;white-space:nowrap;color:var(--color-off-black);transition:color .2s}
.navres summary::-webkit-details-marker{display:none} .navres summary:hover{color:var(--color-smoke)}
.navres summary::after{content:"";flex:none;width:7px;height:7px;border-right:1.5px solid currentColor;border-bottom:1.5px solid currentColor;transform:translateY(-3px) rotate(45deg);transition:transform .2s}
.navres[open] summary::after{transform:translateY(1px) rotate(-135deg)}
.navres__menu{position:absolute;top:calc(100% + 14px);left:-12px;z-index:30;display:grid;gap:8px;min-width:300px;padding:8px;background:var(--color-parchment);border:1px solid var(--color-ash);border-radius:16px;box-shadow:0 16px 40px rgba(36,36,36,.12)}
.site-nav__links .navres__card,.navres__soon{display:flex;align-items:center;gap:14px;min-height:60px;padding:7px 14px 7px 7px;border:1px solid var(--color-ash);border-radius:14px;font-family:var(--font-serif);font-size:18px;text-transform:none;letter-spacing:-.01em;white-space:nowrap;transition:border-color .2s,background-color .2s}
.site-nav__links .navres__menu a.navres__card:hover{border-color:var(--color-off-black);background:rgba(255,255,255,.6);color:var(--color-off-black)}
.navres__icon{flex:none;display:grid;place-items:center;width:44px;height:44px;border-radius:10px;background:#ebe6e3}
.navres__label{flex:1}
.navres__soon{color:var(--color-smoke);cursor:default;background:rgba(36,36,36,.03)}
.navres__soon em{font-family:var(--font-mono);font-style:normal;font-size:12px;text-transform:uppercase;padding:3px 8px;border:1px solid var(--color-ash);border-radius:100px}
@media (max-width:1300px){ .site-nav__inner{gap:20px} .site-nav__links{gap:14px} .site-nav__actions .site-btn{padding-left:20px;padding-right:20px} }
@media (max-width:1140px){ .site-nav__links a,.navres summary{font-size:14px} }
@media (max-width:1100px){ .uib-hero h1{font-size:52px} }
@media (max-width:1040px){
  .site-nav__links,.site-nav__actions{display:none}
  .site-nav__toggle{display:block}
  .nav-open .site-nav__links,.nav-open .site-nav__actions{display:flex;flex-direction:column;position:absolute;left:0;right:0;background:var(--color-parchment);padding:24px var(--gutter)}
  .nav-open .site-nav__links{top:80px;gap:20px;border-top:1px solid var(--color-ash)}
  .nav-open .site-nav__actions{top:300px;border-bottom:1px solid var(--color-ash)}
  .nav-open .navres__menu{position:static;min-width:0;margin-top:12px;padding:0;border:0;border-radius:0;box-shadow:none;background:none}
  .nav-open .navres summary{font-size:18px}
}
@media (max-width:980px){
  :root{--gutter:24px}
  .uib-hero{padding-top:32px;padding-bottom:8px} .uib-hero h1{font-size:40px}
}
.site-nav{font-family:var(--font-mono)}   /* the site header keeps its mono look; the builder body is sans */
button{font:inherit;color:inherit}
svg{flex:none}

.top{height:56px;display:flex;align-items:center;gap:14px;padding:0 20px}
.mark{width:22px;height:22px;border-radius:6px;background:var(--c-pri);display:grid;place-items:center;color:var(--c-pri-fg);font-weight:600;font-size:var(--t-ui)}
.crumb{color:var(--c-muted)}
.crumb b{color:var(--c-text);font-weight:500}
.sp{flex:1}
.ibtn{width:34px;height:34px;display:grid;place-items:center;border:0;background:transparent;border-radius:8px;cursor:pointer}
.ibtn:hover{background:var(--c-hover)}
.cta{height:34px;padding:0 14px;border:0;border-radius:8px;background:var(--c-pri);color:var(--c-pri-fg);font-weight:500;cursor:pointer}
.ghost{height:34px;padding:0 12px;border:1px solid var(--c-line);border-radius:8px;background:var(--c-panel);cursor:pointer}
.ghost:hover{background:var(--c-hover)}

.app{display:grid;grid-template-columns:300px 1fr;gap:12px;padding:0 12px 12px;height:calc(100vh - 56px)}

/* sidebar */
.side{background:var(--c-panel);border:1px solid var(--c-line);border-radius:16px;display:flex;flex-direction:column;overflow:hidden}
.side .scroll{overflow:auto;padding:6px;flex:1}
.grp{font:400 var(--t-title)/1.2 var(--serif);letter-spacing:-.01em;color:var(--c-text);padding:12px 12px 4px;display:flex;align-items:center;gap:6px}
.grp em{font:400 var(--t-micro)/1.4 var(--sans);letter-spacing:0;padding:1px 6px;border-radius:99px;border:1px solid var(--c-line);color:var(--c-text)}
.row{position:relative;display:flex;align-items:center;gap:10px;padding:8px 12px;border-radius:10px;cursor:pointer}
.row:hover{background:var(--c-hover)}
.row:focus-within{outline:2px solid var(--c-line)}
.row .t{flex:1;min-width:0}
.row small{display:block;font-size:var(--t-meta);font-weight:400;color:var(--c-muted);line-height:1.3}
.row b{display:block;font-weight:500;font-size:var(--t-ui);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.row select,.row input[type=color]{position:absolute;inset:0;opacity:0;cursor:pointer;width:100%;height:100%;border:0;font:inherit}
.chip{width:18px;height:18px;border-radius:50%;box-shadow:inset 0 0 0 1px rgba(0,0,0,.12)}
.glyph{font-size:12px;color:var(--c-muted);min-width:22px;text-align:right}
.urlrow{display:flex;gap:6px;padding:4px 12px 8px}
.urlrow input{flex:1;min-width:0;height:32px;border:1px solid var(--c-line);border-radius:8px;padding:0 10px;background:var(--c-bg);color:inherit;font:inherit;font-size:13px}
.urlnote{font-size:var(--t-meta);color:var(--c-muted);padding:0 12px 6px}
.bring{padding:4px 12px 8px;display:grid;gap:6px}
.bring textarea{width:100%;min-height:96px;resize:vertical;border:1px solid var(--c-line);border-radius:8px;padding:8px 10px;background:var(--c-bg);color:inherit;font:400 var(--t-code)/1.6 var(--mono);letter-spacing:0}
.bring textarea.drag{border-color:var(--c-text);border-style:dashed}
.bring .acts{display:flex;gap:6px}
.bring .acts .ghost{height:30px;padding:0 10px}
.bring .ex{font-size:var(--t-meta);color:var(--c-muted)}
.bring .ex button{border:0;background:none;padding:0;color:var(--c-text);text-decoration:underline;cursor:pointer;font-size:var(--t-meta)}
.found{font-size:var(--t-meta);color:var(--c-muted);line-height:1.45}
.found b{color:var(--c-text);font-weight:500}
.foot{border-top:1px solid var(--c-line);padding:10px;display:grid;gap:8px}
.foot .two{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.guard{display:flex;align-items:center;gap:8px;font-size:var(--t-meta);color:var(--fg-2);padding:2px 4px}
.guard i{width:7px;height:7px;border-radius:50%}
.guard button{margin-left:auto;border:0;background:none;text-decoration:underline;cursor:pointer;font-size:var(--t-meta);color:var(--c-text)}

/* canvas */
.canvas{position:relative;background:var(--c-inset);border:1px solid var(--c-line);border-radius:16px;overflow:auto;padding:28px 28px 90px}
.dock{position:sticky;bottom:0;margin:0 auto;width:max-content;max-width:100%;display:flex;gap:4px;padding:5px;border-radius:12px;background:var(--c-panel);border:1px solid var(--c-line);box-shadow:0 8px 30px rgba(0,0,0,.12);flex-wrap:wrap;justify-content:center;translate:0 60px}
.dock button{border:0;background:transparent;padding:6px 11px;border-radius:8px;cursor:pointer;font-size:13px;color:var(--c-muted)}
.dock button[aria-pressed="true"]{background:var(--c-hover);color:var(--c-text);font-weight:500}
.dock .sep{width:1px;background:var(--c-line);margin:4px 2px}

/* ---------- Stage: everything inside is the builder's theme ---------- */
.stage{
  --p:#18181b; --p-fg:#fafafa; --r:10px; --d:1; --m:180ms; --font:Geist,Inter,system-ui,sans-serif;
  --bg:transparent; --card:#ffffff; --text:#09090b; --muted:#71717a; --line:#e4e4e7; --soft:#f4f4f5; --danger:#dc2626; --ok:#16a34a;
  container-type:inline-size; margin:0 auto; max-width:1180px; color:var(--text); font-family:var(--font);
  transition:max-width var(--m) ease;
}
.stage{--page:#f4f4f5; color-scheme:light; background:var(--page); padding:calc(20px*var(--d)); border:1px solid var(--c-line); border-radius:20px}
.stage.dark{color-scheme:dark; --page:#0b0b0d; --card:#141416; --text:#fafafa; --muted:#a1a1aa; --line:#27272a; --soft:#1f1f23; --danger:#f87171; --ok:#4ade80}
.stage.mobile{max-width:390px; border-radius:36px; padding:14px}
.stage.desktop{max-width:1440px}
.stage *{transition:background-color var(--m) ease,color var(--m) ease,border-radius var(--m) ease,padding var(--m) ease}
/* containment: an applied design reaches only what is inside #stage. Containers are capped so no design can make an oval;
   only pill-shaped parts (buttons, tags, switches) may go fully round. The builder's own parts that sit inside the stage
   (the app-preview note, its Android/iOS switch, the phone captions) keep Pramaan's look, not the design's. */
.stage .card,.stage .site,.stage .foot2,.stage .modal .box{border-radius:min(var(--rc,calc(var(--r) + 4px)),28px)}
.stage .appnote,.stage .seg2,.stage .seg2 button,.stage .pf figcaption{font-family:var(--sans);letter-spacing:0;direction:ltr}
.stage.geo-measure,.stage.geo-measure *{transition:none !important}   /* the shape check reads final radii, not a transition's first frame */
.stage .appnote,.stage .seg2 button{font-size:var(--t-ui,13px)}
.stage .pf figcaption{font-size:var(--t-meta,12px)}
/* small builder text on the canvas: --fg-3 is about 4.3:1 there (3.8:1 on the switch track), --fg-2 about 8:1 */
.stage .appnote,.stage .seg2 button:not([aria-pressed="true"]),.stage .pf figcaption{color:var(--fg-2)}
.grid{columns:3;column-gap:calc(16px*var(--d))}
@container (max-width: 920px){ .grid{columns:2} }
@container (max-width: 560px){ .grid{columns:1} }
@container (min-width: 1240px){ .grid{columns:4} }
.card{break-inside:avoid;margin:0 0 calc(16px*var(--d));background:var(--card);border:1px solid var(--line);border-radius:var(--rc,calc(var(--r) + 4px));padding:calc(20px*var(--d));box-shadow:var(--cs,0 1px 2px rgba(0,0,0,.04))}
.ch{display:flex;justify-content:space-between;align-items:flex-start;gap:10px;margin-bottom:calc(14px*var(--d))}
.ch h4{margin:0;font-size:15px;font-weight:600;letter-spacing:-.01em;font-family:var(--hf,inherit)}
.ch p{margin:2px 0 0;font-size:13px;color:var(--muted)}
.lbl{display:block;font-size:13px;font-weight:500;margin:calc(10px*var(--d)) 0 6px}
.inp{width:100%;height:calc(36px*var(--d));padding:0 12px;border:1px solid var(--line);border-radius:var(--ri,calc(var(--r)*.8));background:transparent;color:var(--text);font:inherit;font-size:14px}
.stage .two{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.btn{display:flex;align-items:center;justify-content:center;gap:8px;width:100%;height:calc(38px*var(--d));margin-top:calc(14px*var(--d));border:0;border-radius:var(--rb,calc(var(--r)*.8));background:var(--p);color:var(--p-fg);font:inherit;font-weight:500;font-size:14px;cursor:pointer}
.btn.o{background:transparent;color:var(--text);border:1px solid var(--line);margin-top:8px}
.btn.sm{width:auto;height:30px;padding:0 12px;margin:0;font-size:13px}
.ln{display:flex;justify-content:space-between;font-size:13.5px;color:var(--muted);padding:4px 0}
.ln.t{color:var(--text);font-weight:600;border-top:1px solid var(--line);margin-top:6px;padding-top:10px}
.alert{display:flex;gap:10px;font-size:13px;border-radius:calc(var(--r)*.8);padding:10px 12px;border:1px solid var(--line);margin-bottom:6px}
.alert.err{color:var(--danger);border-color:color-mix(in srgb,var(--danger) 35%,transparent);background:color-mix(in srgb,var(--danger) 7%,transparent)}
.done{text-align:center;padding:calc(10px*var(--d)) 0}
.done .ring{width:44px;height:44px;border-radius:50%;margin:0 auto 10px;display:grid;place-items:center;background:color-mix(in srgb,var(--ok) 14%,transparent);color:var(--ok)}
.done p{margin:0;font-size:14px}
.empty{text-align:center;padding:calc(18px*var(--d)) 8px;color:var(--muted);font-size:13.5px}
.empty .ic{width:42px;height:42px;border-radius:calc(var(--r)*.8);margin:0 auto 10px;display:grid;place-items:center;background:var(--soft);color:var(--text)}
.empty b{display:block;color:var(--text);font-weight:600;margin-bottom:2px}
.sk{height:12px;border-radius:6px;margin:10px 0;background:linear-gradient(90deg,var(--soft),var(--line),var(--soft));background-size:200% 100%;animation:sk 1.3s linear infinite}
@keyframes sk{to{background-position:-200% 0}}
@media (prefers-reduced-motion: reduce){.sk{animation:none}.stage *{transition:none}}
.big{font-size:30px;font-weight:650;letter-spacing:-.02em;line-height:1.1;font-family:var(--hf,inherit)}
.up{font-size:12px;color:var(--ok);margin-left:8px;font-weight:500}
.bars{display:flex;align-items:flex-end;gap:6px;height:120px;margin-top:16px}
.bars span{flex:1;background:var(--p);border-radius:calc(var(--r)*.4) calc(var(--r)*.4) 2px 2px;opacity:.9}
.bars span:nth-child(odd){opacity:.45}
.axis{display:flex;justify-content:space-between;font-size:11px;color:var(--muted);margin-top:6px}
.res{padding:calc(10px*var(--d)) 0;border-top:1px solid var(--line)}
.res a{font-weight:500;font-size:14px;color:var(--text);text-decoration:none}
.res p{margin:3px 0 4px;font-size:13px;color:var(--muted)}
.src{display:inline-flex;align-items:center;gap:6px;font-size:11.5px;color:var(--muted)}
.src i{font-style:normal;min-width:18px;height:18px;border-radius:5px;display:grid;place-items:center;background:var(--soft);color:var(--text);font-size:11px;font-weight:600}
.or{display:flex;align-items:center;gap:10px;color:var(--muted);font-size:12px;margin:12px 0 0}
.or::before,.or::after{content:"";flex:1;height:1px;background:var(--line)}
.ent{display:flex;gap:12px;align-items:center}
.av{width:40px;height:40px;border-radius:calc(var(--r)*.8);background:var(--p);color:var(--p-fg);display:grid;place-items:center;font-weight:600;flex:none}
.av.s{width:34px;height:34px;background:var(--soft);color:var(--text);font-size:12px}
.kv{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:14px}
.kv div{background:var(--soft);border-radius:calc(var(--r)*.8);padding:10px}
.kv small{display:block;font-size:11.5px;color:var(--muted)}
.kv b{font-weight:500;font-size:13.5px}
.tx{display:flex;align-items:center;gap:12px;padding:calc(8px*var(--d)) 0}
.tx .t{flex:1;min-width:0}
.tx b{display:block;font-weight:500;font-size:13.5px}
.tx small{color:var(--muted);font-size:12px}
.tx .amt{font-weight:500;font-size:13.5px;font-variant-numeric:tabular-nums}
.badge{font-size:11px;padding:1px 7px;border-radius:var(--rt,99px);background:var(--soft);color:var(--muted)}
.badge.ok{background:color-mix(in srgb,var(--ok) 14%,transparent);color:var(--ok)}
.badge.err{background:color-mix(in srgb,var(--danger) 14%,transparent);color:var(--danger)}
.badge.p{background:var(--p);color:var(--p-fg)}

/* ---------- component gallery: the common parts of real designs ---------- */
.sec{display:flex;align-items:baseline;gap:8px;flex-wrap:wrap;margin:calc(28px*var(--d)) 2px calc(12px*var(--d));font-size:13px;font-weight:600;color:var(--text)}
.sec small{font-weight:400;color:var(--muted)}
.site{background:var(--card);border:1px solid var(--line);border-radius:var(--rc,calc(var(--r) + 4px));margin-bottom:calc(16px*var(--d));overflow:hidden}
.nav{display:flex;align-items:center;gap:20px;padding:12px 18px;border-bottom:1px solid var(--line)}
.brand{display:flex;align-items:center;gap:8px;font-weight:650}
.logo{width:20px;height:20px;border-radius:calc(var(--r)*.5);background:var(--p)}
.links{display:flex;gap:16px;font-size:13.5px;color:var(--muted);flex:1}
.links a,.lnk{color:inherit;text-decoration:none}
.lnk{font-size:13.5px;color:var(--text)}
.navr{display:flex;align-items:center;gap:12px;margin-left:auto}
.ib.menu{display:none}
.hero{padding:calc(44px*var(--d)) 24px calc(32px*var(--d));text-align:center}
.eyebrow{display:inline-block;font-size:12px;padding:3px 10px;border-radius:99px;border:1px solid var(--line);color:var(--muted);margin-bottom:14px}
.hero h1{margin:0 auto;max-width:620px;font-size:clamp(28px,5cqi,44px);line-height:1.08;letter-spacing:var(--ht,-.03em);font-weight:var(--hw,650);font-family:var(--hf,inherit)}
/* a design whose main button is an outline: border and label in the primary colour, no fill */
.stage.ob .btn:not(.o):not(.g):not(.lk){background:transparent;color:var(--p);box-shadow:inset 0 0 0 1px var(--p)}
.hero p{margin:12px auto 0;max-width:520px;color:var(--muted);font-size:15px}
.ctas{display:flex;gap:10px;justify-content:center;margin-top:20px}
.ctas .btn{width:auto;padding:0 18px;margin:0}
.logos{display:flex;flex-wrap:wrap;gap:12px 28px;justify-content:center;margin-top:28px;font-size:12.5px;font-weight:700;letter-spacing:.14em;color:var(--muted)}
@container (max-width: 560px){ .links,.navr .lnk,.navr .btn{display:none} .ib.menu{display:grid} .ctas{flex-direction:column} }
.wrap{display:flex;flex-wrap:wrap;gap:8px;align-items:center}
.wrap .btn{width:auto;margin:0;padding:0 14px}
.btn.g{background:transparent;color:var(--text)}
.btn.pill{border-radius:99px}
.btn.lk{background:none;color:var(--text);padding:0 4px;text-decoration:underline;text-underline-offset:3px}
.btn[disabled]{opacity:.45;cursor:not-allowed}
.ib{width:calc(36px*var(--d));height:calc(36px*var(--d));display:grid;place-items:center;border:1px solid var(--line);border-radius:calc(var(--r)*.8);background:transparent;color:var(--text);cursor:pointer;padding:0}
.ib.f{background:var(--p);color:var(--p-fg);border-color:transparent}
.chk{display:flex;align-items:center;gap:8px;font-size:13.5px;margin-top:10px}
.chk input{accent-color:var(--p);width:16px;height:16px;margin:0}
.stage .sw{position:relative;width:34px;height:20px;border-radius:99px;background:var(--p);flex:none}
.stage .sw::after{content:"";position:absolute;top:2px;left:16px;width:16px;height:16px;border-radius:50%;background:var(--p-fg)}
.stage .sw.off{background:var(--line)} .stage .sw.off::after{left:2px;background:var(--card)}
.tag{display:inline-flex;align-items:center;gap:6px;font-size:12px;padding:3px 9px;border-radius:var(--rt,calc(var(--r)*.6));border:1px solid var(--line);color:var(--text)}
.seg{display:inline-flex;padding:3px;border-radius:calc(var(--r)*.8);background:var(--soft);gap:2px}
.seg span{padding:5px 12px;border-radius:calc(var(--r)*.6);font-size:13px;color:var(--muted)}
.seg .on{background:var(--card);color:var(--text);box-shadow:0 1px 2px rgba(0,0,0,.08)}
.utabs{display:flex;gap:18px;border-bottom:1px solid var(--line);font-size:13.5px;margin-top:16px}
.utabs span{padding-bottom:8px;color:var(--muted)} .utabs .on{color:var(--text);box-shadow:inset 0 -2px var(--p)}
.alert.info{color:var(--text);background:var(--soft)}
.alert.ok{color:var(--ok);border-color:color-mix(in srgb,var(--ok) 35%,transparent);background:color-mix(in srgb,var(--ok) 7%,transparent)}
.toast{display:flex;gap:10px;align-items:center;padding:11px 12px;border-radius:calc(var(--r)*.8);background:var(--text);color:var(--card);font-size:13px;box-shadow:0 8px 24px rgba(0,0,0,.18);margin-top:10px}
.toast span{flex:1} .toast u{text-underline-offset:3px;cursor:pointer}
.quote{font-size:15px;line-height:1.5;margin:0}
.who{display:flex;gap:10px;align-items:center;margin-top:14px;font-size:13px} .who small{display:block;color:var(--muted)}
.price{font-size:34px;font-weight:650;letter-spacing:-.02em} .price small{font-size:13px;color:var(--muted);font-weight:400}
.feat{list-style:none;padding:0;margin:12px 0 0;font-size:13.5px;display:grid;gap:7px} .feat li{display:flex;gap:8px;align-items:center} .feat svg{color:var(--ok)}
.acc details{border-top:1px solid var(--line);padding:10px 0} .acc details:last-child{border-bottom:1px solid var(--line)}
.acc summary{cursor:pointer;font-weight:500;font-size:14px;list-style:none;display:flex;justify-content:space-between} .acc summary::-webkit-details-marker{display:none}
.acc summary::after{content:"+";color:var(--muted)} .acc details[open] summary::after{content:"–"} .acc p{margin:6px 0 0;font-size:13px;color:var(--muted)}
.code{font:12.5px/1.65 ui-monospace,SFMono-Regular,Menlo,monospace;background:var(--soft);border-radius:calc(var(--r)*.8);padding:12px 14px;overflow:auto;white-space:pre;color:var(--text);margin:0}
.code i{font-style:normal;color:var(--muted)} .code b{font-weight:400;color:var(--ok)}
.prog{height:8px;border-radius:99px;background:var(--soft);overflow:hidden} .prog span{display:block;height:100%;background:var(--p);border-radius:inherit}
.steps{display:flex;gap:8px;margin-top:16px;font-size:12.5px} .steps div{flex:1;display:grid;gap:6px;color:var(--muted)}
.steps i{height:3px;border-radius:99px;background:var(--line)} .steps .done i{background:var(--p)} .steps .now{color:var(--text)} .steps .now i{background:color-mix(in srgb,var(--p) 45%,var(--line))}
.modal{border-radius:calc(var(--r)*.8);background:color-mix(in srgb,var(--text) 30%,transparent);padding:22px 14px}
.modal .box{background:var(--card);border-radius:var(--rc,calc(var(--r) + 4px));padding:16px;box-shadow:0 12px 32px rgba(0,0,0,.25)}
.modal h5{margin:0;font-size:14.5px} .modal p{margin:4px 0 0;font-size:13px;color:var(--muted)} .modal .wrap{justify-content:flex-end;margin-top:14px}
.pop{border:1px solid var(--line);border-radius:calc(var(--r)*.8);background:var(--card);box-shadow:0 8px 24px rgba(0,0,0,.12);padding:4px;font-size:13.5px;margin-top:8px}
.pop div{padding:7px 10px;border-radius:calc(var(--r)*.5)} .pop .on{background:var(--soft)}
.tip{position:relative;display:inline-block;margin-top:36px}
.tip::before{content:attr(data-tip);position:absolute;bottom:calc(100% + 8px);left:50%;translate:-50% 0;white-space:nowrap;font-size:12px;padding:4px 8px;border-radius:6px;background:var(--text);color:var(--card)}
.tbl{width:100%;border-collapse:collapse;font-size:13px} .tbl th{text-align:left;font-weight:500;color:var(--muted);font-size:12px;padding:6px 0;border-bottom:1px solid var(--line)}
.tbl td{padding:8px 0;border-bottom:1px solid var(--line)} .tbl td:last-child,.tbl th:last-child{text-align:right}
.foot2{display:flex;flex-wrap:wrap;gap:18px 40px;justify-content:space-between;padding:20px;border:1px solid var(--line);border-radius:var(--rc,calc(var(--r) + 4px));background:var(--card);font-size:13px;color:var(--muted)}
.foot2 b{color:var(--text);display:block;margin-bottom:6px;font-weight:600} .foot2 div{display:grid;gap:4px}

/* export dialog */
dialog{border:1px solid var(--c-line);border-radius:16px;padding:0;width:min(720px,calc(100vw - 32px));background:var(--c-panel);color:var(--c-text);box-shadow:0 20px 60px rgba(0,0,0,.3)}
dialog::backdrop{background:rgba(0,0,0,.45);backdrop-filter:blur(2px)}
.dh{padding:18px 20px 0;display:flex;justify-content:space-between;align-items:flex-start;gap:12px}
.dh__acts{display:flex;align-items:center;gap:8px;flex:none}
.dx{border:0;background:none;color:var(--c-muted);font-size:24px;line-height:1;cursor:pointer;padding:2px 4px;margin-left:4px} .dx:hover{color:var(--c-text)}
.dh h3{margin:0}
.dh p{margin:4px 0 0;color:var(--c-muted);font-size:var(--t-ui)}
.tabs{display:flex;gap:2px;padding:14px 20px 0;flex-wrap:wrap}
.tabs button{border:0;background:none;padding:6px 10px;border-radius:8px;cursor:pointer;font-size:13px;color:var(--c-muted)}
.tabs button[aria-pressed="true"]{background:var(--c-hover);color:var(--c-text);font-weight:500}
dialog pre{margin:12px 20px;padding:14px;border-radius:10px;background:var(--c-inset);border:1px solid var(--c-line);max-height:300px;overflow:auto;font:400 var(--t-code)/1.6 var(--mono);letter-spacing:0;white-space:pre-wrap;word-break:break-word}
.df{display:flex;justify-content:space-between;align-items:center;gap:8px;padding:0 20px 18px;flex-wrap:wrap}
.df span{font-size:var(--t-meta);color:var(--fg-2)}

/* ---------- native app preview: iOS (Apple guidelines) and Android (Material 3) ---------- */
.stage.ios,.stage.android{max-width:1180px;background:transparent;border:0;padding:0}
.appnote{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;margin:0 auto 18px;max-width:1000px;font-size:13px;color:var(--c-muted)}
.appnote b{color:var(--c-text)}
.seg2{display:inline-flex;padding:3px;border-radius:9px;background:var(--c-hover);gap:2px}
.seg2 button{border:0;background:none;padding:5px 10px;border-radius:7px;font-size:12.5px;color:var(--c-muted);cursor:pointer}
.seg2 button[aria-pressed="true"]{background:var(--c-panel);color:var(--c-text);box-shadow:0 1px 2px rgba(0,0,0,.15)}
.phones{display:flex;gap:26px;justify-content:center;flex-wrap:wrap}
.pf{margin:0;display:grid;gap:10px;justify-items:center}
.pf figcaption{font-size:12.5px;color:var(--c-muted)}
.phone{width:300px;height:630px;border-radius:46px;padding:9px;background:#0d0d0f;box-shadow:0 0 0 1px #2a2a2e,0 24px 50px rgba(0,0,0,.35)}
.phone.android{border-radius:34px}
.scr{position:relative;width:100%;height:100%;border-radius:38px;overflow:hidden;background:var(--page);color:var(--text);font-family:var(--appfont);display:flex;flex-direction:column;font-size:14px}
.android .scr{border-radius:26px}
/* clip-path, not only overflow: blurred bars (backdrop-filter) ignore border-radius clipping in Chrome */
.ios .scr{clip-path:inset(0 round 38px)} .android .scr{clip-path:inset(0 round 26px)}
.scr *{transition:none}
.scr .body{flex:1;overflow:hidden;position:relative}
.sb{display:flex;align-items:center;justify-content:space-between;padding:0 24px;font-size:13px;font-weight:600;flex:none;position:relative}
.ios .sb{height:46px} .android .sb{height:30px;padding:0 18px;font-weight:500;font-size:12px}
.sb .island{position:absolute;top:11px;left:50%;translate:-50% 0;width:88px;height:26px;border-radius:20px;background:#000}
.sb .cam{position:absolute;top:9px;left:50%;translate:-50% 0;width:11px;height:11px;border-radius:50%;background:#000}
.sb .ic3{display:flex;gap:4px;align-items:center}
.homebar{position:absolute;bottom:7px;left:50%;translate:-50% 0;width:108px;height:5px;border-radius:9px;background:var(--text);opacity:.85}
.android .homebar{width:96px;height:4px;bottom:6px;opacity:.6}
.tint{color:var(--p);display:inline-flex;align-items:center;gap:2px}
.sk2{height:12px;border-radius:6px;background:var(--soft);margin:10px 0}
/* iOS */
.ios-nav{display:flex;justify-content:space-between;align-items:center;height:30px;padding:0 14px;font-size:15px}
.ios-large{margin:0;padding:2px 16px 10px;font-size:28px;font-weight:700;letter-spacing:-.02em;line-height:1.1}
.ios-h{font-size:11.5px;text-transform:uppercase;letter-spacing:.02em;color:var(--muted);padding:2px 30px 6px}
.ios-group{margin:0 14px 16px;background:var(--card);border-radius:min(calc(var(--r) + 2px),14px);overflow:hidden}
.ios-row{position:relative;display:flex;align-items:center;gap:10px;padding:10px 14px;min-height:44px;font-size:14px}
/* iOS separators start where the text starts, not at the cell edge */
.ios-row::after{content:"";position:absolute;left:14px;right:0;bottom:0;height:.5px;background:var(--line)}
.ios-row:has(> .av)::after{left:58px} .ios-row:has(> .tint)::after{left:43px} .ios-row:last-child::after{display:none}
.ios-row .t{flex:1;min-width:0} .ios-row .t b{display:block;font-weight:500} .ios-row .t small{color:var(--muted);font-size:12px}
.ios-row .lab{width:62px;color:var(--text)} .ios-row .val{flex:1;color:var(--muted);white-space:nowrap} .ios-row .chev{color:var(--muted);opacity:.6}
.ios-row.del{color:var(--danger);justify-content:center}
.ios-stat{padding:14px} .ios-stat small{color:var(--muted);font-size:12px} .ios-stat .big{font-size:28px;display:block;margin-top:2px}
.bars.s{height:62px;margin-top:10px;gap:4px}
.ios-sw{width:44px;height:26px;border-radius:99px;background:var(--p);position:relative;flex:none}
.ios-sw::after{content:"";position:absolute;top:2px;left:20px;width:22px;height:22px;border-radius:50%;background:#fff;box-shadow:0 2px 4px rgba(0,0,0,.25)}
.ios-sw.off{background:var(--soft)} .ios-sw.off::after{left:2px}
.ios-segw{padding:0 16px 14px} .ios-seg{display:flex;background:var(--soft);border-radius:9px;padding:2px;font-size:13px}
.ios-seg span{flex:1;text-align:center;padding:5px 0;border-radius:7px;color:var(--text)} .ios-seg .on{background:var(--card);box-shadow:0 1px 3px rgba(0,0,0,.15);font-weight:600}
.ios-foot{font-size:12px;color:var(--muted);padding:0 30px 14px;margin-top:-10px} .ios-foot.err{color:var(--danger)}
.ios-btn{display:block;width:calc(100% - 28px);margin:0 14px;height:48px;border:0;border-radius:min(calc(var(--r) + 4px),24px);background:var(--p);color:var(--p-fg);font:inherit;font-size:16px;font-weight:600}
.ios-link{display:block;margin:10px auto 0;border:0;background:none;color:var(--p);font:inherit;font-size:15px}
.ios-tabs{position:absolute;left:0;right:0;bottom:0;display:flex;justify-content:space-around;padding:7px 0 24px;background:color-mix(in srgb,var(--card) 88%,transparent);backdrop-filter:blur(18px);box-shadow:inset 0 .5px 0 var(--line)}
.ios-tabs span,.m3-nav span{display:grid;justify-items:center;gap:2px;font-size:10px;color:var(--muted)} .ios-tabs .on{color:var(--p)}
.ios-dim{position:absolute;inset:0;z-index:5;background:rgba(0,0,0,.35);display:grid;place-items:center}
.ios-alert{width:236px;border-radius:14px;background:color-mix(in srgb,var(--card) 92%,transparent);backdrop-filter:blur(20px);text-align:center;overflow:hidden}
.ios-alert b{display:block;padding:16px 16px 2px;font-size:15px} .ios-alert p{margin:0;padding:0 16px 14px;font-size:12.5px;color:var(--text)}
.ios-alert .bt{display:flex;box-shadow:inset 0 .5px 0 var(--line)} /* Apple: in a destructive alert, Cancel is the bold (preferred) action and Delete is plain red */
.ios-alert .bt span{flex:1;padding:11px 0;color:var(--p);font-size:15px;font-weight:600} .ios-alert .bt span+span{box-shadow:inset .5px 0 0 var(--line);color:var(--danger);font-weight:400}
.ios-done{text-align:center;padding:40px 24px} .ios-done .ring{width:64px;height:64px;border-radius:50%;margin:0 auto 14px;display:grid;place-items:center;background:color-mix(in srgb,var(--ok) 16%,transparent);color:var(--ok)}
/* Android, Material 3 */
.m3-bar{display:flex;align-items:center;gap:14px;height:56px;padding:0 14px;font-size:20px;flex:none}
.m3-bar .tt{flex:1}
.m3-card{margin:6px 14px 14px;padding:16px;border-radius:calc(var(--r) + 2px);background:var(--m3-sfc);box-shadow:0 1px 2px rgba(0,0,0,.18)}
.m3-card small{color:var(--muted);font-size:12px} .m3-card .big{font-size:28px;display:block;margin-top:2px}
.m3-sub{font-size:13px;font-weight:500;color:var(--p);padding:4px 18px 6px}
.m3-li{display:flex;align-items:center;gap:14px;padding:9px 18px;min-height:56px}
.m3-li .t{flex:1;min-width:0} .m3-li .t b{display:block;font-weight:400;font-size:14.5px} .m3-li .t small{color:var(--muted);font-size:12.5px}
.m3-av{width:38px;height:38px;border-radius:50%;display:grid;place-items:center;background:var(--m3-pc);color:var(--m3-onpc);font-size:13px;font-weight:500;flex:none}
.m3-ic{color:var(--muted);display:grid}
.m3-fab{position:absolute;right:16px;bottom:94px;width:52px;height:52px;border-radius:16px;display:grid;place-items:center;background:var(--m3-pc);color:var(--m3-onpc);box-shadow:0 4px 10px rgba(0,0,0,.25)}
.m3-nav{position:absolute;left:0;right:0;bottom:0;display:flex;justify-content:space-around;padding:10px 0 20px;background:var(--m3-sfc)}
.m3-nav i{display:grid;place-items:center;width:56px;height:30px;border-radius:15px} .m3-nav .on{color:var(--text);font-weight:600} .m3-nav .on i{background:var(--m3-sc)}
.m3-chips{display:flex;gap:8px;padding:2px 16px 14px}
.m3-chip{display:inline-flex;align-items:center;gap:6px;height:32px;padding:0 12px;border-radius:8px;border:1px solid var(--line);font-size:13px}
.m3-chip.on{background:var(--m3-sc);border-color:transparent}
.m3-tf{position:relative;margin:0 16px 16px;height:52px;border:1px solid var(--muted);border-radius:4px;display:flex;align-items:center;padding:0 14px;font-size:14.5px}
.m3-tf label{position:absolute;top:-8px;left:10px;padding:0 4px;background:var(--page);font-size:11.5px;color:var(--muted)}
.m3-tf.focus{border:2px solid var(--p)} .m3-tf.focus label{color:var(--p)}
.m3-tf.err{border:2px solid var(--danger)} .m3-tf.err label{color:var(--danger)}
.m3-help{margin:-12px 30px 14px;font-size:11.5px;color:var(--danger)}
.m3-two{display:flex} .m3-two .m3-tf{flex:1} .m3-two .m3-tf+.m3-tf{margin-left:0}
.m3-sw{position:relative;width:46px;height:28px;border-radius:99px;background:var(--p);flex:none}
.m3-sw::after{content:"";position:absolute;top:4px;left:22px;width:20px;height:20px;border-radius:50%;background:var(--p-fg)}
.m3-sw.off{background:var(--soft);box-shadow:inset 0 0 0 2px var(--muted)} .m3-sw.off::after{top:7px;left:7px;width:14px;height:14px;background:var(--muted)}
.m3-btn{display:block;width:calc(100% - 32px);margin:4px 16px 0;height:42px;border:0;border-radius:var(--m3-btn-r);background:var(--p);color:var(--p-fg);font:inherit;font-size:14px;font-weight:500;letter-spacing:.01em}
.m3-tbtn{display:block;margin:8px auto 0;border:0;background:none;color:var(--p);font:inherit;font-size:14px;font-weight:500}
.m3-dim{position:absolute;inset:0;z-index:5;background:rgba(0,0,0,.38);display:grid;place-items:center}
.m3-dialog{width:250px;padding:22px 22px 14px;border-radius:28px;background:var(--m3-sfc)}
.m3-dialog b{display:block;font-size:19px;font-weight:400;margin-bottom:10px} .m3-dialog p{margin:0;font-size:13px;color:var(--muted)}
.m3-dialog .bt{display:flex;justify-content:flex-end;gap:18px;margin-top:18px;font-size:14px;font-weight:500;color:var(--p)}
.m3-snack{position:absolute;left:12px;right:12px;bottom:88px;display:flex;align-items:center;gap:10px;padding:12px 14px;border-radius:4px;background:var(--text);color:var(--card);font-size:13px;box-shadow:0 4px 10px rgba(0,0,0,.25)}
.m3-snack span{flex:1} .m3-snack u{text-decoration:none;color:var(--m3-inv-p);font-weight:500}
.m3-done{text-align:center;padding:40px 24px} .m3-done .ring{width:64px;height:64px;border-radius:50%;margin:0 auto 14px;display:grid;place-items:center;background:var(--m3-pc);color:var(--m3-onpc)}
.m3-banner{display:flex;gap:10px;margin:6px 14px 14px;padding:12px;border-radius:12px;background:color-mix(in srgb,var(--danger) 14%,var(--page));color:var(--danger);font-size:13px}

/* ---------- Acme sample content (stage only) and Get code copy feedback ---------- */
.stage .ac-head{display:flex;flex-wrap:wrap;align-items:baseline;gap:2px 0}
.stage .ac-vs{margin-inline-start:8px;font-size:12px;color:var(--muted)}
.stage .ac-chart{display:grid;grid-template-columns:28px minmax(0,1fr);column-gap:8px;row-gap:6px;margin-top:calc(18px*var(--d));font-variant-numeric:tabular-nums}
.stage .ac-y{position:relative;height:120px;font-size:11px;line-height:1;color:var(--muted);text-align:end}
.stage .ac-y span{position:absolute;inset-inline-end:0;bottom:var(--y);translate:0 50%}
.stage .ac-plot{position:relative;height:120px}
.stage .ac-g{position:absolute;inset-inline:0;height:0;bottom:calc(var(--y) - 1px);border-top:1px solid var(--line)}
.stage .ac-bars{position:absolute;inset:0;display:flex;align-items:flex-end;gap:4px}
.stage .ac-b{flex:1;min-width:0;background:var(--p);border-radius:min(calc(var(--r)*.4),4px) min(calc(var(--r)*.4),4px) 0 0}
.stage .ac-mark{position:absolute;top:0;bottom:0;inset-inline-start:50%;border-inline-start:1px dashed var(--muted)}
.stage .ac-mark span{position:absolute;top:2px;inset-inline-end:6px;white-space:nowrap;font-size:11px;line-height:1.2;color:var(--muted);background:var(--card);padding:1px 4px}
.stage .ac-days{grid-column:2;display:flex;gap:4px;font-size:11px;line-height:1;color:var(--muted)}
.stage .ac-days span{flex:1;min-width:0;text-align:center}
.stage .ac-mini span,.stage .ac-mini span:nth-child(odd){opacity:.9}
.stage .ac-fine{display:block;margin-top:12px;font-size:12.5px;color:var(--muted)}
.stage .ac-logos{margin-top:calc(30px*var(--d))}
.stage .ac-cap{display:block;font-size:12px;color:var(--muted);margin-bottom:12px}
.stage .ac-row{display:flex;flex-wrap:wrap;justify-content:center;align-items:center;gap:12px 28px}
.stage .ac-wm{display:inline-flex;align-items:center;gap:6px;font-size:15px;line-height:1;color:var(--muted)}
.stage .ac-wm svg{flex:none}
.stage .ac-w1{font-weight:800;letter-spacing:-.03em}
.stage .ac-w2{font-weight:500;text-transform:lowercase}
.stage .ac-w3{font-family:Georgia,'Times New Roman',serif;font-style:italic;font-size:16px}
.stage .ac-w4{font-weight:600;font-size:14px}
.stage .ac-w4 em{font-family:Georgia,'Times New Roman',serif;font-style:italic;font-weight:400}
.stage .ac-w5{font-variant-caps:all-small-caps;font-weight:600;font-size:16px}
.stage .ac-src{align-items:flex-start;line-height:1.4}
.stage .ac-src i{margin-top:-1px}
.stage .ac-status{display:inline-flex;align-items:center;gap:6px;justify-self:start;margin-top:4px;font-size:12px}
.stage .ac-dot{width:8px;height:8px;border-radius:50%;background:var(--ok);flex:none}
.gc-copy{min-width:112px}
.cta.gc-copy[data-state="copied"],.cta.gc-copy[data-state="copied"]:hover{background:var(--done);border-color:var(--done);color:#fff;box-shadow:none}
.df .gc-status{flex:1 0 100%;min-height:1.5em;font-family:var(--sans);font-size:var(--t-meta,12px);line-height:1.5;color:var(--done)}
.df .gc-status.gc-err{color:var(--blocked)}
.cta.gc-copy[data-state="failed"],.cta.gc-copy[data-state="failed"]:hover{background:var(--blocked);border-color:var(--blocked);color:#fff;box-shadow:none}

/* notifications (builder chrome, top right) */
.notice{display:flex;gap:10px;align-items:flex-start;
  padding:12px 12px 12px 14px;border-radius:12px;background:var(--c-panel);color:var(--c-text);border:1px solid var(--c-line);
  box-shadow:0 14px 36px rgba(0,0,0,.32);font-size:13px;animation:nin .18s ease}
.notice[hidden]{display:none}
.notice .dot{width:8px;height:8px;border-radius:50%;margin-top:5px;flex:none;background:var(--c-ok)}
.notice.warn .dot{background:#f59e0b} .notice.err .dot{background:var(--c-bad)} .notice.info .dot{background:var(--c-muted)}
.notice .nt{flex:1;min-width:0;display:grid;gap:3px} .notice .nt span{color:var(--fg-2);line-height:1.4}
.notice .na{display:flex;gap:12px;margin-top:6px}
.notice .na button,.notice .x{border:0;background:none;color:var(--c-text);cursor:pointer;font-size:var(--t-meta);padding:0}
.notice .na button{text-decoration:underline;text-underline-offset:3px} .notice .x{font-size:16px;line-height:1;color:var(--c-muted)}
@keyframes nin{from{opacity:0;transform:translateY(-6px)}}
@media (prefers-reduced-motion: reduce){.notice{animation:none}}
/* notices are a stack: #notice (.nq) is the fixed container, each message is a static .notice.nq-item with its own timer */
.nq{position:fixed;top:66px;right:16px;z-index:60;width:min(360px,calc(100vw - 32px));display:grid;gap:8px;pointer-events:none}
.nq:empty{display:none}
.nq .notice.nq-item{max-width:100%;pointer-events:auto;font-family:var(--sans);letter-spacing:0;text-transform:none}
.nq-item .nt b{font-size:13px;font-weight:600;letter-spacing:0}
.nq-item .nt span{font-size:var(--t-meta,12px);letter-spacing:0}
.nq-item .na button,.nq-item .x{font-family:inherit;letter-spacing:0;text-transform:none}
@media (min-width: 861px){ .nq{top:128px;right:28px} body.uib-focus .nq{top:72px} }
@media (max-width: 860px){ .nq-item .na button{min-height:44px;padding:0 4px} .nq-item .x{min-width:44px;min-height:44px} }
/* shape check, persistent Undo, corner glyph (builder chrome) */
.geo-read{margin-top:6px}
.guard .geo-undo{display:flex;align-items:center;margin:0 0 6px;padding:2px 0;min-height:28px}
@media (max-width: 860px){ .guard .geo-undo{min-height:44px} }
.sp-seg .sp-cg{display:block;width:20px;height:20px}
.sp-cname .sp-px{margin-left:6px}

/* editable colour table */
.ctab{padding:2px 6px 6px}
.crow{position:relative;display:flex;align-items:center;gap:10px;padding:6px 8px;border-radius:8px;cursor:pointer}
.crow:hover{background:var(--c-hover)}
.crow input[type=color]{position:absolute;inset:0;opacity:0;cursor:pointer;width:100%;height:100%;border:0}
.crow .sw2{width:22px;height:22px;border-radius:6px;box-shadow:inset 0 0 0 1px rgba(127,127,127,.4);flex:none}
.crow .t{flex:1;min-width:0}
.crow b{display:block;font-weight:500;font-size:var(--t-ui);color:var(--fg)}
.crow code{font:400 var(--t-meta)/1.3 var(--mono);letter-spacing:0;font-variant-numeric:tabular-nums;color:var(--c-muted);margin-left:4px}
.crow small{display:block;font-size:var(--t-meta);font-weight:400;color:var(--c-muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.crow .undo{position:relative;z-index:1;border:0;background:none;color:var(--c-text);cursor:pointer;font-size:var(--t-meta);text-decoration:underline}

/* readability check */
.guard{display:block}
.read summary{display:flex;align-items:center;gap:8px;cursor:pointer;list-style:none;font-size:12px;color:var(--c-muted)}
.read summary::-webkit-details-marker{display:none}
.read summary::after{content:"▾";margin-left:auto}
.read[open] summary::after{content:"▴"}
.read .ck{display:flex;align-items:center;gap:7px;font-size:12px;padding:3px 0 0 2px}
.read .ck span{flex:1;color:var(--c-muted)}
.read .ck button{margin:0}
.read .list{max-height:230px;overflow:auto;padding-top:4px}
/* a failing button check offers two fixes, each with a tiny button showing the result */
.read .fx2{display:grid;gap:5px;padding:4px 0 2px 16px}
.read .fx2 button{display:flex;align-items:center;gap:6px;margin:0;padding:3px 8px 3px 3px;border:1px solid var(--line);border-radius:var(--r-pill);background:var(--surface-sunk);color:var(--fg);text-decoration:none;font-size:var(--t-meta);text-align:left;line-height:1.25}
.read .fx2 button:hover{background:var(--btn-glass-hover)} .read .fx2 small{display:block;color:var(--fg-2);font-size:var(--t-micro)}
.read .fxs{flex:none;padding:2px 7px;border-radius:99px;font-size:var(--t-micro);font-weight:600}

/* design browser */
#gal{width:min(1080px,calc(100vw - 32px))}
/* clear edges where the scrolling grid meets the filters and the footer: cards fade out at both ends
   (the top fade sits in the grid's 14px padding, so the first row is untouched until you scroll) */
#gal .df{padding-top:14px;border-top:1px solid rgba(0,0,0,.1)}
#gal .ggrid{mask-image:linear-gradient(transparent,#000 14px,#000 calc(100% - 28px),transparent)}
.gbar{display:flex;gap:8px;align-items:center;padding:14px 20px 0;flex-wrap:wrap}
.gbar input{flex:1;min-width:200px;height:34px;border:1px solid var(--c-line);border-radius:8px;padding:0 12px;background:var(--c-bg);color:inherit;font:inherit;font-size:var(--t-body);line-height:1.5}
.gfil{display:flex;gap:8px;align-items:center;flex-wrap:wrap;padding:10px 20px 12px;font-size:var(--t-meta);font-weight:400;color:var(--fg-2)}
.gfil[hidden]{display:none}
.gfil select{height:32px;padding:0 10px;border-radius:var(--r-pill);border:1px solid var(--line);background:var(--surface-sunk);color:var(--fg);font:inherit;font-size:var(--t-ui);cursor:pointer}
.gfil select.set{border-color:var(--fg);background:var(--btn-glass-hover)}
.gfil button[data-clear]{border:0;background:none;color:var(--fg);text-decoration:underline;text-underline-offset:3px;cursor:pointer;font-size:var(--t-meta)}
.gfil i{width:10px;height:10px;border-radius:50%;display:inline-block;box-shadow:inset 0 0 0 1px rgba(127,127,127,.4)}
.ggrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(190px,1fr));gap:12px;padding:14px 20px;max-height:60vh;overflow:auto}
.gcard{border:1px solid var(--c-line);border-radius:12px;overflow:hidden;background:var(--c-inset);cursor:pointer;text-align:left;padding:0;color:inherit;font:inherit}
.gcard:hover,.gcard:focus-visible{outline:2px solid var(--c-text);outline-offset:1px}
.gth{position:relative;display:block;aspect-ratio:16/10;overflow:hidden;background:var(--c-line)}
.gth img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:50% 0;transform:scale(1.06);transition:transform .45s ease}
.gcard:hover .gth img,.gcard:focus-visible .gth img{transform:scale(1)}
/* Hover pop-out: a larger floating preview beside the card that scrolls the site's full page */
/* It is a popover so it sits above the dialog and is placed against the window; the dialog's glass blur would otherwise trap and clip it. */
.gpop{position:fixed;inset:auto;margin:0;padding:0;z-index:5;width:420px;height:540px;border-radius:14px;overflow:hidden;background:var(--c-inset);border:1px solid var(--c-line);
  box-shadow:0 26px 70px rgba(0,0,0,.55);pointer-events:none;opacity:0;transform:scale(.96);transition:opacity .18s ease,transform .18s ease}
.gpop.on{opacity:1;transform:none}
.gpop img{display:block;width:100%;transform:translateY(0)}
.gpop.on img.run{transform:translateY(var(--dist,0));transition:transform var(--scroll,5s) linear .5s}
.gpop .cap{position:absolute;left:0;right:0;bottom:0;padding:22px 14px 12px;background:linear-gradient(transparent,rgba(0,0,0,.78));color:#fff;font-size:var(--t-meta)}
.gpop .cap b{display:block;font-size:var(--t-body)}
.gcard .bad{display:inline-block;margin-left:6px;font-size:var(--t-micro);font-weight:400;padding:0 6px;border-radius:99px;border:1px solid var(--c-line);color:var(--fg-2)}
@media (prefers-reduced-motion: reduce){ .gth img{transform:none} .gpop.on img.run{transform:none;transition:none} }
.gcard div{padding:8px 10px 10px}
.gcard b{display:block;font-size:var(--t-ui);font-weight:500;color:var(--fg);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.gcard small{font-size:var(--t-meta);font-weight:400;color:var(--fg-2)}
.gdet{display:grid;grid-template-columns:minmax(0,1.6fr) minmax(240px,1fr);gap:18px;padding:14px 20px}
.gdet[hidden],.ggrid[hidden],.gbar[hidden]{display:none}
.gshot{max-height:62vh;overflow:auto;border:1px solid var(--c-line);border-radius:12px;background:var(--c-inset)}
.gshot img{display:block;width:100%}
.ginfo{display:grid;gap:10px;align-content:start;font-size:var(--t-body);line-height:1.5}
.ginfo h4{margin:0} .ginfo a{color:var(--fg-2)}
.ginfo .ns{color:var(--c-text);font-style:italic} .ginfo .meta{color:var(--fg-2)}
.ginfo p{margin:0;color:var(--fg-2);font-size:var(--t-body);line-height:1.5;max-height:10em;overflow:auto}
.gsw{display:flex;gap:6px;flex-wrap:wrap} .gsw i{width:22px;height:22px;border-radius:6px;box-shadow:inset 0 0 0 1px rgba(127,127,127,.4)}
.ginfo .acts{display:flex;gap:8px;flex-wrap:wrap;margin-top:4px}
.ginfo small{color:var(--fg-2);font-size:var(--t-meta);font-weight:400}
@media (max-width: 760px){ .gdet{grid-template-columns:1fr} }
.gnone{grid-column:1/-1;color:var(--fg-2);font-size:var(--t-body);line-height:1.5;margin:20px 0;text-align:center}

/* ---------- Glass chrome: islands, pill buttons, one accent (DESIGN.md §6–7) ---------- */
/* numbers line up and do not jump as they change */
.side,.top,dialog,.ddm,.notice,#notice{font-variant-numeric:tabular-nums}
.top,.side,.canvas{background:var(--glass);-webkit-backdrop-filter:blur(var(--blur)) saturate(1.1);backdrop-filter:blur(var(--blur)) saturate(1.1);
  border:1px solid var(--glass-edge);box-shadow:var(--glass-shadow);border-radius:var(--r-island)}
.top{height:56px;margin-top:var(--gap);padding:0 12px 0 20px;gap:10px}
.app{gap:var(--gap);padding:var(--gap) 0;height:calc(100vh - 80px - 56px - var(--gap));min-height:560px}
/* line the builder up with the header and heading column */
.top,.app{width:calc(100% - 2*var(--gutter));max-width:calc(var(--page-max-width) - 2*var(--gutter));margin-left:auto;margin-right:auto}
.wordmark{display:inline-flex;align-items:center;gap:7px;font:400 var(--t-bar) var(--serif);letter-spacing:-.02em;color:var(--fg);text-decoration:none}
.wordmark i{width:8px;height:8px;border-radius:50%;background:var(--fg);margin-top:6px}
.crumb{font:400 var(--t-bar) var(--serif);letter-spacing:-.02em;color:var(--fg);white-space:nowrap}
@media (max-width:600px){ body .top{height:auto;flex-wrap:wrap;padding:12px 16px;row-gap:8px} .top .sp{flex-basis:100%;height:0} }
.shared{font-size:12px;color:var(--fg-2);padding:3px 10px;border:1px solid var(--line);border-radius:999px}
/* quiet glass button (default) and the thread button (the single accent, for the main action) */
.ghost,.cta{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:36px;padding:0 16px;border-radius:var(--r-pill);
  border:1px solid var(--btn-edge);background:var(--btn-glass);box-shadow:var(--btn-shadow);-webkit-backdrop-filter:blur(var(--blur-btn));backdrop-filter:blur(var(--blur-btn));
  color:var(--fg);font-size:var(--t-ui);font-weight:500;text-transform:none;letter-spacing:0;white-space:nowrap;cursor:pointer;transition:background .12s,transform .12s}
.ghost:hover{background:var(--btn-glass-hover)} .ghost:active,.cta:active{transform:translateY(1px)}
.cta{background:var(--thread);border-color:var(--thread-edge);color:var(--on-thread);box-shadow:0 1px 0 var(--thread-edge) inset,0 4px 14px var(--thread-glow)}
.cta:hover{background:var(--thread-solid)}
/* the one uppercase text in the builder's frame: the primary action */
.cta[data-open-export]{text-transform:uppercase;letter-spacing:.04em;font-size:var(--t-meta)}
.ibtn{width:36px;height:36px;border-radius:var(--r-pill);color:var(--fg)} .ibtn:hover{background:var(--btn-glass-hover)}
:where(button,a,input,select,textarea,summary,[tabindex]):focus-visible{outline:2px solid var(--focus);outline-offset:2px}
/* sidebar */
.side .scroll{padding:10px 8px}
.grp{font:400 var(--t-title)/1.2 var(--serif);letter-spacing:-.01em;text-transform:none;color:var(--fg);padding:14px 12px 4px}
.grp em{border-color:var(--line);color:var(--fg-2);border-radius:var(--r-pill)}
.row,.crow{border-radius:var(--r-ctl)} .row:hover,.crow:hover{background:var(--surface-sunk)}
.row small{color:var(--fg-2)} .row b{color:var(--fg)}
/* A row is outlined only while tabbing (html[data-kb], set in the script), never after a mouse click.
   :focus-visible alone can't do this: Chrome counts a clicked <select> as keyboard-focused. */
.row:focus-within{outline:none} html[data-kb] .row:focus-within,html[data-kb] .crow:focus-within{outline:2px solid var(--focus);outline-offset:-2px}
.row select:focus-visible,.row input:focus-visible,.crow input:focus-visible{outline:none}
/* colour dots and swatches get a light ring, so near-black colours stay visible on dark glass */
.chip,.crow .sw2{box-shadow:0 0 0 1px var(--glass-edge),inset 0 0 0 1px rgba(127,127,127,.35)}
.urlrow input,.bring textarea,.gbar input{background:var(--glass-strong);border:1px solid var(--line);border-radius:var(--r-ctl);color:var(--fg)}
.urlrow input:focus,.bring textarea:focus,.gbar input:focus{border-color:var(--fg);outline:none}
.urlnote,.found,.bring .ex{color:var(--fg-2)} .found b,.bring .ex button{color:var(--fg)}
.foot{border-top:1px solid var(--line-soft);padding:12px}
.side .ghost{height:32px;padding:0 12px;border-color:var(--line);background:var(--surface-sunk);box-shadow:none;-webkit-backdrop-filter:none;backdrop-filter:none}
.side .ghost:hover{background:var(--line)}
/* settings panel: the first choices are visible controls in plain words, the extras sit in closed groups.
   One active state everywhere (aria-checked): white fill + ink ring + weight 500 on segments, a double ring on round swatches. */
.side .scroll{padding:10px 10px 14px;overscroll-behavior:contain}
@media (min-width:861px){ .side .scroll{scrollbar-gutter:stable} .foot > .cta{display:none} }   /* the toolbar holds the one filled Get code */
.sp-h{font:400 var(--t-title)/1.2 var(--serif);text-transform:none;letter-spacing:-.01em;color:var(--fg);padding:16px 12px 8px}
/* small text in the panel: --fg-3 is 4.26:1 on the panel glass, under the 4.5:1 that 11-12.5px text needs; --fg-2 is about 8:1 */
.sp-h .sp-cnote{margin-left:auto;font:400 var(--t-meta)/1.2 var(--sans);text-transform:none;letter-spacing:0;color:var(--fg-2)}
.side .urlnote,.side .found,.side .bring .ex,.side .read summary,.sp-more .crow code,.sp-more .crow small{color:var(--fg-2)}
.sp-hint{margin:2px 0 4px;padding:10px 34px 10px 12px;position:relative;border:1px dashed var(--line);border-radius:var(--r-ctl);font-size:var(--t-ui);line-height:1.45;color:var(--fg-2)}
.sp-hint button{position:absolute;top:4px;right:4px;width:28px;height:28px;border:0;border-radius:var(--r-pill);background:none;color:var(--fg-2);font-size:18px;line-height:1;cursor:pointer}
.sp-hint button:hover{background:var(--btn-glass-hover);color:var(--fg)}
.sp-presets{display:grid;grid-template-columns:repeat(5,1fr);gap:0}
.sp-pre{display:flex;flex-direction:column;align-items:center;justify-content:flex-start;gap:6px;min-width:0;min-height:64px;padding:6px 0 4px;border:0;border-radius:var(--r-ctl);background:none;
  color:var(--fg-2);font:inherit;font-size:var(--t-meta);letter-spacing:0;cursor:pointer}
/* a style is a small card, not a dot: its own corners (set inline) and its own font, so it never reads as a colour swatch */
.sp-pre .sw{width:44px;height:32px;border-radius:50%;display:grid;place-items:center;font-size:15px;line-height:1;letter-spacing:0;box-shadow:0 0 0 1px var(--glass-edge),inset 0 0 0 1px rgba(127,127,127,.35)}
.sp-pre .nm{line-height:1.15;text-align:center} .sp-pre .nm small{display:block;font-size:var(--t-micro);letter-spacing:0;color:var(--fg-2);font-weight:400}
.sp-pre[aria-checked="true"]{color:var(--fg);font-weight:500}
.sp-pre[aria-checked="true"] .sw{box-shadow:0 0 0 2px var(--bg),0 0 0 4px var(--fg)}
.sp-pre:not([aria-checked="true"]):hover{background:var(--btn-glass-hover)}
.sp-browse{width:calc(100% - 4px);margin:8px 2px 0;justify-content:center}
.sp-lab{display:flex;align-items:baseline;justify-content:space-between;gap:8px;padding:12px 12px 6px;font-size:var(--t-ui);line-height:1.3;color:var(--fg-2)}
.sp-lab > span:first-child{font-weight:500;color:var(--fg)}
.sp-swatches + .row{margin-top:10px}

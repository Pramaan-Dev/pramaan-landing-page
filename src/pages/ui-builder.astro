}
$('#guard').addEventListener('click', e => {
  if (e.target.closest('[data-geofix]')) { e.preventDefault(); geoFix(); }
  else if (e.target.closest('#undoLast')) { e.preventDefault(); undoDesign(); $('#guard summary')?.focus({preventScroll:true}); } });
// a web font arriving changes text widths, so the "cut off" answer is measured again once it has loaded
let geoFontTimer;
document.fonts?.addEventListener?.('loadingdone', () => { clearTimeout(geoFontTimer); geoFontTimer = setTimeout(() => {
  geoCache = {key:'', res:null}; if (!$('#guard').contains(document.activeElement)) drawGuard(); }, 150); });

/* ---------- design browser: 1,282 real styles in designs/ ---------- */
// Designs a viewer hid as broken (their own browser only; the team list is designs/_hidden.json)
let hiddenSet = null;
const hiddenDesigns = () => hiddenSet || (hiddenSet = new Set((() => { try { return JSON.parse(localStorage.getItem('pramaan-hidden-designs') || '[]'); } catch { return []; } })()));
const saveHidden = () => { try { localStorage.setItem('pramaan-hidden-designs', JSON.stringify([...hiddenDesigns()])); } catch {} };
const G = {q:'', th:'all', n:60, i:'', c:'', r:''};
// Filters built from each design's own data (scripts/build_gallery.py): industry label, main colour, corner style
const FILTERS = [['i', 'Industry', v => v[0].toUpperCase() + v.slice(1)], ['c', 'Colour', v => v === 'neutral' ? 'Black and white' : v[0].toUpperCase() + v.slice(1)],
  ['r', 'Corners', v => ({sharp:'Sharp (0–2px)', soft:'Soft (3–10px)', round:'Round (11–24px)', pill:'Pill (25px+)'})[v] || v]];
const SWATCH = {red:'#dc2626', orange:'#ea580c', yellow:'#eab308', green:'#16a34a', teal:'#0d9488', blue:'#2563eb', purple:'#7c3aed', pink:'#db2777', neutral:'#8a8a8a'};
// Words people type that mean a filter value ("rounded blue fintech"), matched against the design's labels too
const labelsOf = d => `${d.i} ${d.th} ${d.c === 'neutral' ? 'black white monochrome neutral' : d.c} ${({sharp:'sharp square', soft:'soft', round:'round rounded', pill:'pill rounded'})[d.r] || ''}`;
function drawGallery(){
  const list = window.DESIGNS;
  if (!list) { $('#galSub').textContent = 'Design library not found.'; $('#galMore').hidden = true;
    $('#galGrid').innerHTML = '<p class="gnone">Put this page next to the designs/ folder and run <code>python3 scripts/build_gallery.py</code>.</p>'; return; }
  const words = G.q.toLowerCase().split(/\s+/).filter(Boolean);
  const ordered = G.order && G.order.length === list.length ? G.order.map(i => list[i]) : list, hid = hiddenDesigns();
  const shown = ordered.filter(d => !hid.has(d.s));
  const pass = (d, skip) => (G.th === 'all' || d.th === G.th) && FILTERS.every(([k]) => k === skip || !G[k] || d[k] === G[k]);
  // Every word must appear somewhere; a hit in the name or site ranks above one in the labels, above one in the description
  const score = d => { let s = 0; const name = `${d.t} ${d.d}`.toLowerCase(), lab = labelsOf(d).toLowerCase(), rest = `${d.ns} ${d.fo} ${d.k} ${d.x}`.toLowerCase();
    for (const w of words) { if (name.includes(w)) s += 8; else if (lab.split(' ').includes(w)) s += 4; else if (rest.includes(w)) s += 1; else return 0; } return s || 1; };
  let hits = shown.filter(d => pass(d)).map(d => [score(d), d]).filter(([s]) => s > 0);
  if (words.length) hits.sort((a, b) => b[0] - a[0]);          // stable sort: the shuffled order breaks ties
  hits = hits.map(([, d]) => d);
  $('#galSub').textContent = `${hits.length.toLocaleString()} of ${shown.length.toLocaleString()} designs`;
  // each dropdown counts what choosing that value would show, given the other filters
  $('#galFil').innerHTML = FILTERS.map(([k, label, nice]) => { const n = {};
      for (const d of shown) if (d[k] && pass(d, k) && (!words.length || score(d))) n[d[k]] = (n[d[k]] || 0) + 1;
      return `<select data-f="${k}" class="${G[k] ? 'set' : ''}" aria-label="${label}"><option value="">${label}: any</option>`
        + Object.keys(n).sort((a, b) => n[b] - n[a]).map(v => `<option value="${v}" ${G[k] === v ? 'selected' : ''}>${nice(v)} (${n[v]})</option>`).join('') + `</select>`; }).join('')
    + (G.c ? `<i style="background:${SWATCH[G.c]}"></i>` : '')
    + (G.i || G.c || G.r || G.th !== 'all' || G.q ? `<button data-clear>Clear all</button>` : '');
  dress($('#galFil'));
  $('#galTh').innerHTML = ['all','light','dark'].map(v => `<button data-th="${v}" aria-pressed="${G.th === v}">${v[0].toUpperCase() + v.slice(1)}</button>`).join('');
  $('#galGrid').innerHTML = hits.slice(0, G.n).map(d => `<button class="gcard" data-s="${d.s}" aria-label="${escA(d.d || d.t)}, ${escA([d.th, d.i].filter(Boolean).join(', '))}"><span class="gth">`
    + `<img class="g0" loading="lazy" alt="" src="${DB}${d.s}/${d.img}"></span>`
    + `<div><b>${esc(d.t)}</b><small>${esc([d.th, d.i].filter(Boolean).join(' · '))}</small></div></button>`).join('') || '<p class="gnone">No designs match. Try fewer words, or clear a filter.</p>';
  $('#galMore').hidden = hits.length <= G.n;
}
// A fresh random order every time the browser opens, so people see new references; it stays put while they search
function openGallery(){
  const list = window.DESIGNS || [];

const skel = n => Array.from({length:n}, (_, i) => `<div class="sk2" style="width:${90 - i * 14}%"></div>`).join('');

// Material 3 needs "container" shades of primary; derived here from the brand colour for each mode
function appVars(os, T){
  const dark = S.mode === 'dark', v = {};
  if (os === 'android') Object.assign(v, {
    '--m3-pc': dark ? mix(T.primary, '#000000', .55) : mix(T.primary, '#ffffff', .8),
    '--m3-onpc': dark ? mix(T.primary, '#ffffff', .75) : mix(T.primary, '#000000', .55),
    '--m3-sc': mix(T.primary, T.card, dark ? .78 : .86),
    '--m3-sfc': mix(T.card, T.primary, .04),
    '--m3-inv-p': dark ? mix(T.primary, '#000000', .2) : mix(T.primary, '#ffffff', .55),
    '--m3-btn-r': S.radius < 6 ? S.radius + 'px' : '21px'});   // Material buttons are pills unless the brand is square-cornered
  v['--appfont'] = S.appFont === 'system'
    ? (os === 'ios' ? "-apple-system, 'SF Pro Text', 'Helvetica Neue', system-ui, sans-serif" : "Roboto, 'Google Sans', system-ui, sans-serif") : S.font;
  return Object.entries(v).map(([k, x]) => `${k}:${x}`).join(';');
}


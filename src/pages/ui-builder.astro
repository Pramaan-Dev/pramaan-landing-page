      : `<div class="ac-head"><span class="big">${AC_FMT(AC_TOTAL)}</span><span class="up">+18.2%</span><span class="ac-vs">vs previous 14 days</span></div>
         ${acChart()}`;
    return card('API calls', 'Last 14 days · all endpoints', body, `<span class="badge ok">Live</span>`);
  })();

  const checkout = (() => {
    const summary = `<div class="ln" style="margin-top:12px"><span>Pro · monthly</span><span>${price}</span></div>
      <div class="ln"><span>Tax</span><span>Included</span></div>
      <div class="ln t"><span>Total</span><span>${price}</span></div>`;
    const body = st==='loading' ? sk(5)

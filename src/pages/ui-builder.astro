/* ---------- stage fit: the preview is as large and as whole as the canvas allows (cv- variables live on #canvas) ---------- */
let cvLast = '';
const fitStage = () => {
  const c = $('#canvas'), st = $('#stage'); if (!c || !st) return;
  if (!matchMedia('(min-width:861px)').matches) { c.style.removeProperty('--cv-fit'); c.style.removeProperty('--cv-h'); return; }
  const dev = ['desktop', 'mobile', 'ios', 'android'].find(d => st.classList.contains(d)) || '';
  if (dev !== cvLast) { cvLast = dev; c.scrollTop = 0; st.scrollTop = 0; }
  const h = c.clientHeight - 40, w = c.clientWidth - 44; // 4px of slack so rounding never wraps the row
  c.style.setProperty('--cv-h', Math.max(420, h - 20) + 'px');
  // 952x662 is the natural size of the three-phone row (3x300 + 2x26 wide; 630 + 10 + caption tall). The note above it changes height with the zoom, so measure twice.
  for (let i = 0; i < 2; i++) {
    const note = st.querySelector('.appnote'), availH = h - (note ? note.offsetHeight + 18 : 0);
    // floor .45: at 861-975px the canvas is narrower than 952x.6, and the row must shrink rather than wrap a phone below
    c.style.setProperty('--cv-fit', (Math.floor(Math.max(.45, Math.min(1.35, availH / 662, w / 952)) * 1000) / 1000).toFixed(3));
  }
};
if ('ResizeObserver' in window) new ResizeObserver(fitStage).observe($('#canvas'));
new MutationObserver(fitStage).observe($('#stage'), {childList: true});

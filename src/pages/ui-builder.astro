      : `${st==='error'?errB(C.payErr):''}<label class="lbl">Card number</label><input class="inp" value="4242 4242 4242 4242" aria-label="Card number">
         <div class="two"><div><label class="lbl">Expiry</label><input class="inp" value="12 / 29" aria-label="Expiry"></div><div><label class="lbl">CVC</label><input class="inp" value="123" aria-label="CVC"></div></div>
         ${summary}<button class="btn">${C.payB(price)}</button>`;
    return card(C.payH, 'Billed monthly, cancel anytime.', body);
  })();

  const search = (() => {
    const box = `<input class="inp" value="${st==='empty'?'export invoices to Xero':'Can I get a refund on an annual plan?'}" aria-label="Search">`;
    const R = [['Annual plans: 30-day refund window','Billing policy · section 4.2 · updated 12 Oct','Full refund within 30 days of purchase, pro-rated credit after that.'],
               ['How refunds are paid out','Help centre · Refunds and credits','Back to the original card in 5 to 7 business days.'],
               ['Seats added mid-term','Terms of service · section 7.3','Seats added during a term are refunded pro rata.']];
    const body = box + (st==='loading' ? sk(6)
      : st==='empty' ? emptyB(I.search, C.srchEmpty, `<br><span>${C.srchEmptyS}</span>`)
      : st==='error' ? `<div style="margin-top:12px">${errB(C.netErr)}</div>`
      : `<div style="margin-top:12px">${R.map((r,i)=>`<div class="res"><a href="#">${r[0]}</a><p>${r[2]}</p><span class="src ac-src"><i>${i+1}</i>${r[1]}</span></div>`).join('')}</div>`);
    return card(C.srchH, 'Answers with a source on every line', body, `<span class="badge">cited</span>`);
  })();

  const signin = (() => {
    const body = st==='loading' ? sk(4)
      : st==='success' ? `<div class="done"><div class="ring">${ico(I.check)}</div><p>${C.signOk}</p></div>`
      : `${st==='error'?errB(C.signErr):''}<label class="lbl">Email</label><input class="inp" ${st==='empty'?'placeholder="name@company.com"':'value="maya@haldenfreight.com"'} aria-label="Email">
         <button class="btn">${C.signB}</button><div class="or">or</div><button class="btn o">Continue with Google</button>`;
    return card(C.signH, C.signS, body);
  })();

  const company = (() => {
    const body = st==='loading' ? sk(5) : st==='empty' ? emptyB(I.building, 'No company found', '<br><span>Check the domain and try again.</span>') : st==='error' ? errB(C.netErr)
      : `<div class="ent"><div class="av">H</div><div><b style="font-weight:600">Halden Freight</b><div style="font-size:13px;color:var(--muted)">Logistics software · Rotterdam</div></div></div>
         <div class="kv"><div><small>Employees</small><b>212</b></div><div><small>Founded</small><b>2016</b></div><div><small>Funding</small><b>Series B · $34M</b></div><div><small>Last checked</small><b>2 hours ago</b></div></div>`;
    return card('Company', 'Matched from 3 sources', body);
  })();

  const payments = (() => {
    const T = [['HF','Halden Freight','Team · annual · 12 seats',14256,'Paid'],['CH','Corvane Health','Pro · monthly',29,'Paid'],['QL','Quillon Labs','Pro · monthly',29,'Refunded'],['MF','Marlow & Finch','Starter · monthly',9,'Paid']];
    const body = st==='loading' ? sk(6) : st==='empty' ? emptyB(I.inbox, 'No payments yet', '<br><span>They appear here as soon as one clears.</span>') : st==='error' ? errB(C.netErr)
      : T.map(t=>`<div class="tx"><div class="av s">${t[0]}</div><div class="t"><b>${esc(t[1])}</b><small>${t[2]}</small></div><div style="text-align:right"><div class="amt">${money(t[3])}</div><span class="badge ${t[4]==='Paid'?'ok':''}">${t[4]}</span></div></div>`).join('');
    return card('Recent payments', 'Across your customers', body, `<button class="btn o sm">View all</button>`);
  })();

  return [usage, checkout, search, signin, company, payments].join('');
}


const money = usd => { const [loc,cur] = S.locale.split('|'); return new Intl.NumberFormat(loc,{style:'currency',currency:cur,maximumFractionDigits:cur==='INR'?0:2}).format(usd*LOCALES[S.locale]); };
const sk = n => Array.from({length:n},(_,i)=>`<div class="sk" style="width:${92-i*13}%"></div>`).join('');
const ico = d => `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${d}</svg>`;
const I = {check:'<path d="M20 6 9 17l-5-5"/>', alert:'<circle cx="12" cy="12" r="9"/><path d="M12 8v4M12 16h.01"/>', search:'<circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>', cart:'<circle cx="9" cy="20" r="1"/><circle cx="18" cy="20" r="1"/><path d="M3 4h2l2.4 11h11.2L21 8H6.2"/>', chart:'<path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/>', inbox:'<path d="M22 12h-6l-2 3h-4l-2-3H2"/><path d="M5.5 5h13L22 12v7H2v-7z"/>', building:'<rect x="4" y="3" width="16" height="18" rx="1"/><path d="M9 7h1M14 7h1M9 11h1M14 11h1M9 15h6"/>'};

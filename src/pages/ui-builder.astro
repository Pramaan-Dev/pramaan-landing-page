// Loads a font from Google Fonts. Known paid fonts are never requested, and other names are fetched first and only
// added if Google has them, so a missing font does not show up as a failed stylesheet in the browser.
const loadFont = name => {
  if (!name || /^(system-ui|sans-serif|serif|monospace|ui-|-apple)/i.test(name)) return;
  const low = name.toLowerCase(), free = FREE_FAMILY[low];
  if (free && free[0] !== 'g') {   // Fontshare or Fontsource: their stylesheets always exist, so link them directly
    const id = 'ff-' + name.replace(/\W/g,''); if (document.getElementById(id)) return;
    const [src, , slug, w] = free, urls = src === 's' ? [`https://api.fontshare.com/v2/css?f[]=${slug}@${w.join(',')}&display=swap`]
      : w.map(n => `https://cdn.jsdelivr.net/npm/@fontsource/${slug}/${n}.css`);
    urls.forEach((href, i) => document.head.appendChild(Object.assign(document.createElement('link'), {id: id + (i || ''), rel:'stylesheet', href})));
    return;
  }
  if (GF_ALIAS[name] || Object.keys(LOOKALIKE).some(k => low.includes(k))) return;   // not on Google Fonts
  const id = 'gf-' + name.replace(/\W/g,''); if (document.getElementById(id)) return;
  const style = Object.assign(document.createElement('style'), {id}); document.head.appendChild(style);
  fetch(`https://fonts.googleapis.com/css2?family=${encodeURIComponent(name).replace(/%20/g,'+')}:wght@400;500;600;700&display=swap`)
    .then(r => r.ok ? r.text() : '').then(css => { style.textContent = css; }).catch(() => {});
};

/* ---------- notifications ---------- */
// lastUndo is the snapshot the Undo restores; lastUndoWhat names it ("the ThoughtLab design", "Surprise me") for the Undo
// button under the settings, which stays until it is used or a style is chosen, whatever happens to the notices.
let lastUndo = null, lastUndoWhat = '';
const NQ_MAX = 3;
/** The notice stack. #notice is the container (a labelled live region); each message is its own .notice.nq-item. */
function nqHost(){
  let h = $('#notice');
  if (h) return h;
  h = Object.assign(document.createElement('div'), {id:'notice', className:'nq'});
  h.setAttribute('role', 'region'); h.setAttribute('aria-label', 'Notifications'); h.setAttribute('aria-live', 'polite');
  document.body.appendChild(h);
  // Undo and the x close their message; "Review colours" and "Upload your font" leave it open
  h.addEventListener('click', e => { const b = e.target.closest('[data-a]'), el = b?.closest('.nq-item'); if (!el) return;
    if (b.dataset.a === 'x') return nqClose(el);
    const act = el._actions[Number(b.dataset.a)]; if (!act) return;
    act[1](); if (act[0] === 'Undo') nqClose(el); });
  return h;
}
const nqClose = el => { clearTimeout(el._t); el.remove(); };
/** Top-right message. actions: [['label', fn], …]. opts: {key, sticky}; a boolean is the old "queue" flag and is ignored, because
 *  every message now has its own slot. The same key replaces its message in place; at most three show, and a fourth removes the
 *  oldest message that has no actions first. Plain messages close after 6 s, ones with actions after 12 s; hover and focus pause
 *  the timer. Focus is never moved. */
function notify(title, text, kind = 'ok', actions = [], opts = {}){
  if (!opts || typeof opts !== 'object') opts = {};
  const host = nqHost(), key = opts.key || '', life = opts.sticky ? 0 : actions.length ? 12000 : 6000;
  const el = document.createElement('div');
  el.className = `notice nq-item ${kind}`; el.setAttribute('role', kind === 'err' ? 'alert' : 'status'); el._actions = actions;
  if (key) el.dataset.key = key;
  el.innerHTML = `<i class="dot"></i><div class="nt"><b>${title}</b>${text ? `<span>${text}</span>` : ''}`
    + `${actions.length ? `<div class="na">${actions.map(([l], i) => `<button type="button" data-a="${i}">${l}</button>`).join('')}</div>` : ''}</div>`
    + `<button type="button" class="x" data-a="x" aria-label="Dismiss">×</button>`;
  const held = () => el.matches(':hover') || el.matches(':focus-within');
  const arm = () => { clearTimeout(el._t); if (life) el._t = setTimeout(() => { if (held()) return arm(); nqClose(el); }, life); };
  el.addEventListener('mouseenter', () => clearTimeout(el._t));
  el.addEventListener('mouseleave', () => { if (!held()) arm(); });
  el.addEventListener('focusin', () => clearTimeout(el._t));
  el.addEventListener('focusout', () => setTimeout(() => { if (el.isConnected && !held()) arm(); }));
  const same = key && [...host.children].find(c => c.dataset.key === key);
  if (same) { clearTimeout(same._t); same.replaceWith(el); }
  else { host.append(el);
    while (host.children.length > NQ_MAX) { const old = [...host.children].slice(0, -1);
      nqClose(old.find(c => !c._actions.length) || old.find(c => !c._actions.some(a => a[0] === 'Undo')) || old[0]); } }
  arm();
}
function undoDesign(){
  if (!lastUndo) return; Object.assign(S, JSON.parse(lastUndo)); lastUndo = null; lastUndoWhat = '';
  normLook();
  for (const f of S.font.split(',').slice(0, 2)) loadFont(f.replace(/['"]/g,'').trim());
  render(); notify('Design undone', 'Back to how it was before.', 'info', [], {key:'design'});
}
const showColours = () => { const c = $('.ctab'); if (c) c.previousElementSibling.scrollIntoView({behavior:'smooth', block:'start'}); };

/** A library design's ready-made look (built from its style.json by scripts/look.py) in parseDesign's shape, plus the
 *  extras a plain file can't give: heading font, radius per element, button and card style, spacing. */
function lookToDesign(L){
  const pal = {...L.pal}; if (L.radius?.base != null) pal.radius = L.radius.base; if (L.font) pal.font = L.font;
  return {kind:'style guide', light:L.mode === 'light' ? pal : {}, dark:L.mode === 'dark' ? pal : {},
    sources:{light:L.mode === 'light' ? L.src : {}, dark:L.mode === 'dark' ? L.src : {}}, substitute:L.sub, look:L};
}
/** The design's extras, while they still fit: the heading font only while the body font is the design's, the per-element
 *  radii only while the radius is the design's. Change either and everything follows your choice instead. */
function activeStyle(){
  const X = S.style; if (!X || !S.imported) return {};
  // radii by role: containers stop at R_CARD_MAX; only buttons, inputs and tags may be a pill (999px). Nothing else ever gets 999.
  const R = X.radius || {}, rad = S.radius === X.base, num = n => typeof n === 'number' && Number.isFinite(n) && n >= 0;
  const card = n => num(n) ? Math.min(n, R_CARD_MAX) + 'px' : null, v = n => num(n) ? (n >= 100 ? '999px' : n + 'px') : null;
  return {'--hf':S.font === X.bodyStack ? X.headStack : null, '--hw':S.font === X.bodyStack ? X.headWeight : null,
    '--ht':S.font === X.bodyStack && X.headTrack != null ? X.headTrack + 'em' : null,
    '--rb':rad ? v(R.btn) : null, '--rc':rad ? card(R.card) : null, '--ri':rad ? v(R.input) : null, '--rt':rad ? v(R.tag) : null,
    '--cs':X.cardShadow === false ? 'none' : null, ob:X.btn === 'outline'};
}
function applyDesign(given){
  const text = S.importText.trim();
  if (!text) { S.importNote = 'Paste or upload a file first.'; render(); return notify('Nothing to apply', 'Paste or upload a design file first.', 'err'); }
  const d = given?.look ? given : parseDesign(text);
  if (d.error) { S.importNote = d.error; render(); return notify('Could not read that file', d.error, 'err'); }
  const {light, dark} = d, rawRadius = light.radius ?? dark.radius, raw = light.font ?? dark.font;
  // a radius from a file or the library is bounded here: above R_BASE_MAX it becomes Full, and a library look keeps its pill buttons
  const cr = rawRadius == null ? null : capRadius(rawRadius), radius = cr ? cr.r : null;
  // a site's own private font (a build-time @font-face alias) is never shown by name: it becomes the closest free font
  const privFont = raw && isPrivateFont(raw) ? raw : null, font = raw && !privFont ? (FREE_FONTS[raw.toLowerCase()]?.[1] || cleanFontName(raw) || raw) : null;
  const privAlt = privFont ? lookalike(privFont, d.substitute) : '';
  for (const s of [light, dark]) { delete s.radius; delete s.font; }
  // text on primary must be readable on primary, or the button label disappears
  const lp = light.primary || dark.primary;
  if (light.primaryFg && (!lp || contrast(light.primaryFg, lp) < 3)) delete light.primaryFg;
  if (dark.primaryFg && contrast(dark.primaryFg, dark.primary || lp || '#ffffff') < 3) delete dark.primaryFg;
  const slots = new Set([...Object.keys(light), ...Object.keys(dark)]);
  if (!slots.size && radius == null && !font && !privFont) {
    S.importNote = `Nothing recognised in this ${d.kind}. Name tokens like primary, background, text, border, radius or font.`; render();
    return notify('Nothing applied', `No colours, radius or font found in this ${d.kind}.`, 'err');
  }
  lastUndo = JSON.stringify(snapshot()); lastUndoWhat = S.importFrom ? `the ${S.importFrom} design` : 'applying your design file';   // for the Undo
  if (!S.imported) S.beforeImport = {primary:S.primary, font:S.font, radius:S.radius, density:S.density, preset:S.preset};
  if (light.primary || dark.primary) S.primary = light.primary || dark.primary;
  delete light.primary;                                   // light primary lives in S.primary so the picker can change it
  if (radius != null) S.radius = radius;
  S.fontNote = '';
  if (privFont) {   // no warning and no raw name: the preview uses the free match and says so
    S.font = `'${privAlt}', system-ui, sans-serif`; canonFont(); loadFont(privAlt);
    S.fontNote = `This site uses its own private font. Showing ${esc(privAlt)}, the closest free match. Upload the font file if you have it.`; }
  else if (font) { const alt = FREE_FAMILY[font.toLowerCase()] ? '' : GF_ALIAS[font] || lookalike(font, d.substitute);
    S.font = `'${font}'${alt && alt !== font ? `, '${alt}'` : ''}, system-ui, sans-serif`; canonFont(); loadFont(font); if (alt) loadFont(alt); checkFont(); }
  S.style = null;
  let privHead = null;
  if (d.look) { const L = d.look, X = S.style = {bodyStack:S.font, base:S.radius, radius:L.radius, headWeight:L.headWeight, headTrack:L.headTrack,
      cardShadow:L.cardShadow, btn:L.btn};
    // a capped radius leaves the design's pill buttons and tags in place; S.radius === X.base keeps them while Full is selected
    if (cr?.pill) X.radius = {...L.radius, btn:L.radius?.btn ?? 999, tag:L.radius?.tag ?? 999};
    S.density = L.density || 1;
    if (L.head) { const hp = isPrivateFont(L.head), h = hp ? '' : FREE_FONTS[L.head.toLowerCase()]?.[1] || cleanFontName(L.head) || L.head,
        alt = hp ? lookalike(L.head, L.headSub) : FREE_FAMILY[h.toLowerCase()] ? '' : GF_ALIAS[h] || lookalike(h, L.headSub);
      if (hp) privHead = {name:L.head, alt};
      X.headStack = hp ? `'${alt}', ${S.font}` : `'${h}'${alt && alt !== h ? `, '${alt}'` : ''}, ${S.font}`; if (h) loadFont(h); if (alt) loadFont(alt); } }
  // the design's own text and notes may name the private font too: show the free match there as well
  for (const p of [privFont && {name:privFont, alt:privAlt}, privHead]) if (p) {
    if (given?.look) S.importText = hideFont(S.importText, p.name, p.alt);
    if (d.sources) for (const m of ['light', 'dark']) for (const k in d.sources[m]) d.sources[m][k] = hideFont(d.sources[m][k], p.name, p.alt); }
  S.edits = null; S.sources = d.sources;
  const darkOnly = !Object.keys(light).length && Object.keys(dark).length > 0, lightOnly = Object.keys(light).length > 0 && !Object.keys(dark).length;
  if (darkOnly) S.mode = 'dark';
  if (lightOnly) S.mode = 'light';   // after a dark design, a light one would otherwise show on the default dark palette
  S.imported = {light, dark}; S.preset = 'custom';
  if (radius != null) slots.add('radius'); if (font || privFont) slots.add('font');
  const missing = ['primary','bg','text','line','radius','font'].filter(k => !slots.has(k)).map(k => SLOT_LABEL[k]);
  const from = S.importFrom ? esc(S.importFrom) : d.kind; S.importFrom = null;
  S.importNote = '';   // success is told by the notification below; the sidebar note only shows problems
  render();
  const colours = [...slots].filter(k => k !== 'radius' && k !== 'font').length;
  notify(`${from} loaded`, `${colours} colour${colours === 1 ? '' : 's'}${radius != null ? ', radius' : ''}${privFont ? `, font ${esc(privAlt)} (closest match to the site's own font)` : font ? `, font ${esc(font)}` : ''}`
    + `${darkOnly ? ' · dark-only, switched to dark' : Object.keys(dark).length ? ' · light and dark' : ''}`
    + `${missing.length ? ` · not in file: ${missing.join(', ')}` : ''}.`, missing.length > 2 ? 'warn' : 'ok',
    [['Undo', undoDesign], ['Review colours', showColours]], {key:'design'});
}

async function readDesignFile(f){
  if (!f) return;
  if (!f.size) { S.importNote = `${esc(f.name)} is empty (0 bytes). Save the file, then upload it again.`; return render(); }
  if (f.size > 500_000) { S.importNote = 'That file is over 500 KB. Paste just the colour, type and radius parts.'; return render(); }
  S.importText = await f.text(); applyDesign();
}


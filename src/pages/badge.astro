---
import Base from '../layouts/Base.astro';
---
<Base title={"Pramaan — Badges for founding members and contributors"} description={"Mint a Pramaan badge for founding members, contributors, provider partners and early testers."} nav="badge" footer="halftone">
<Fragment slot="head">
<link rel="stylesheet" href="/components/lanyard-badge.css" />
  <link rel="stylesheet" href="/components/halftone-footer.css" />
  <script is:inline src="/components/lanyard-badge.js" defer></script>
  <script is:inline src="/components/halftone-footer.js" defer></script>
</Fragment>


  

  <main>

    <!-- Hero -->
    <section class="badge-hero">
      <div class="wash wash--hero-a" aria-hidden="true"></div>
      <div class="container">
        <span class="eyebrow">Badges</span>
        <h1 class="h-lg badge-hero__title">A badge for the people who built Pramaan with us.</h1>
        <p class="lead">Founding members, contributors, provider partners and early testers each get their own. Fill in the details, swing it around, then download it or share the link.</p>
      </div>
    </section>

    <!-- Mint -->
    <section class="mint" id="mint">
      <div class="container mint__inner">
        <form class="mint__panel" id="mint-form" autocomplete="off">
          <fieldset class="field">
            <legend class="field__label">Badge</legend>
            <div class="seg" role="radiogroup" aria-label="Badge tier">
              <label class="chip"><input type="radio" name="tier" value="founding" checked /><span>Founding member</span></label>
              <label class="chip"><input type="radio" name="tier" value="contributor" /><span>Contributor</span></label>
              <label class="chip"><input type="radio" name="tier" value="provider" /><span>Provider partner</span></label>
              <label class="chip"><input type="radio" name="tier" value="tester" /><span>Early tester</span></label>
            </div>
          </fieldset>

          <label class="field">
            <span class="field__label">Name</span>
            <input class="input" name="name" maxlength="40" placeholder="Asha Rao" />
          </label>
          <label class="field">
            <span class="field__label">Role</span>
            <input class="input" name="role" maxlength="48" placeholder="Built the payments flow" />
          </label>
          <div class="field__row">
            <label class="field">
              <span class="field__label">Member no.</span>
              <input class="input" name="no" inputmode="numeric" maxlength="6" placeholder="7" />
            </label>
            <label class="field">
              <span class="field__label">Year</span>
              <input class="input" name="year" inputmode="numeric" maxlength="4" placeholder="2026" />
            </label>
          </div>

          <fieldset class="field">
            <legend class="field__label">Ornament</legend>
            <div class="seg" role="radiogroup" aria-label="Ornament">
              <label class="chip"><input type="radio" name="ornament" value="seal" checked /><span>Proof seal</span></label>
              <label class="chip"><input type="radio" name="ornament" value="mandala" /><span>Mandala</span></label>
            </div>
          </fieldset>

          <div class="mint__id">
            <span class="field__label">Badge ID</span>
            <code id="badge-id">PRM-—</code>
          </div>

          <div class="mint__actions">
            <button type="button" class="btn btn--blue" data-action="download">Download badge <span class="btn__arrow" aria-hidden="true">&#9656;</span></button>
            <button type="button" class="btn btn--ghost" data-action="share">Copy share link</button>
          </div>
          <p class="mint__note" id="mint-status" role="status">Downloads the front and back as PNGs.</p>
        </form>

        <div class="mint__stage">
          <lanyard-badge id="badge" card-width="260"></lanyard-badge>
          <p class="mint__hint caption">Drag to swing &middot; flick to spin &middot; tap to flip</p>
        </div>
      </div>
    </section>

    <!-- Tiers -->
    <section class="section" id="tiers">
      <div class="container">
        <div class="section__head">
          <span class="eyebrow">Four badges</span>
          <h2 class="h-lg">Who gets which.</h2>
        </div>
        <div class="tiers">
          <article class="card tier" data-reveal>
            <span class="tier__swatch" style="--a: var(--color-gold); --b: var(--color-coral)" aria-hidden="true"></span>
            <h3 class="h-card">Founding member</h3>
            <p>Joined Pramaan during early access. Numbered in the order they joined.</p>
          </article>
          <article class="card tier" data-reveal>
            <span class="tier__swatch" style="--a: var(--color-mint); --b: var(--color-sky-blue)" aria-hidden="true"></span>
            <h3 class="h-card">Contributor</h3>
            <p>Added something to the platform: a new capability, a fix, docs or a recipe.</p>
          </article>
          <article class="card tier" data-reveal>
            <span class="tier__swatch" style="--a: var(--color-sky-blue); --b: var(--color-periwinkle-mist)" aria-hidden="true"></span>
            <h3 class="h-card">Provider partner</h3>
            <p>Their service is one of the tools Pramaan can use to get a job done.</p>
          </article>
          <article class="card tier" data-reveal>
            <span class="tier__swatch" style="--a: var(--color-coral); --b: var(--color-gold)" aria-hidden="true"></span>
            <h3 class="h-card">Early tester</h3>
            <p>Ran real jobs in early access and told us what broke.</p>
          </article>
        </div>
      </div>
    </section>

  </main>

  
<Fragment slot="footer">
<halftone-footer wordmark="pramaan" label="Pramaan" meta="Say what you need. Keep the proof.">
    <nav data-title="Product"><a href="/#how">How it works</a><a href="/#tasks">What you can do</a><a href="/#pricing">Pricing</a></nav>
    <nav data-title="Community"><a href="#mint">Badges</a><a href="/developers">For developers</a><a href="#">Contact</a></nav>
    <nav data-title="Start"><a href="/#start">Get early access</a><a href="#login">Log in</a></nav>
    <p data-legal>&copy; 2026 Pramaan &middot; <a href="/legal/privacy">Privacy</a> &middot; <a href="/legal/terms">Terms</a></p>
  </halftone-footer>
</Fragment>
<Fragment slot="foot">
<script is:inline>
    // Badge page: form ↔ <lanyard-badge> ↔ share link.
    (() => {
      const TIERS = {
        founding: { title: "Founding Member", wash: "gold,coral", ink: "gold" },
        contributor: { title: "Contributor", wash: "mint,sky-blue", ink: "mint" },
        provider: { title: "Provider Partner", wash: "sky-blue,periwinkle-mist", ink: "periwinkle-mist" },
        tester: { title: "Early Tester", wash: "coral,gold", ink: "coral" },
      };
      const form = document.getElementById("mint-form");
      const badge = document.getElementById("badge");
      const idEl = document.getElementById("badge-id");
      const status = document.getElementById("mint-status");
      const year = String(new Date().getFullYear());

      // Prefill from the URL so a shared link shows the same badge.
      const q = new URLSearchParams(location.search);
      for (const k of ["name", "role", "no", "year"]) if (q.get(k)) form.elements[k].value = q.get(k);
      if (TIERS[q.get("tier")]) form.querySelector(`[name=tier][value="${q.get("tier")}"]`).checked = true;
      if (q.get("ornament") === "mandala") form.querySelector('[name=ornament][value="mandala"]').checked = true;

      const values = () => {
        const f = new FormData(form);
        return {
          tier: f.get("tier") || "founding",
          ornament: f.get("ornament") || "seal",
          name: (f.get("name") || "").trim(),
          role: (f.get("role") || "").trim(),
          no: (f.get("no") || "").replace(/\D/g, ""),
          year: (f.get("year") || "").replace(/\D/g, "") || year,
        };
      };

      const apply = () => {
        const v = values();
        const t = TIERS[v.tier];
        badge.setAttribute("heading", t.title);
        badge.setAttribute("wash", t.wash);
        badge.setAttribute("ink", t.ink);
        badge.setAttribute("ornament", v.ornament);
        badge.setAttribute("name", v.name || "Your name");
        badge.setAttribute("role", v.role);
        badge.setAttribute("number", v.no);
        badge.setAttribute("year", v.year);
        if (badge.badgeId) idEl.textContent = badge.badgeId();
        const p = new URLSearchParams();
        p.set("tier", v.tier);
        if (v.ornament !== "seal") p.set("ornament", v.ornament);
        for (const k of ["name", "role", "no"]) if (v[k]) p.set(k, v[k]);
        if (v.year !== year) p.set("year", v.year);
        history.replaceState(null, "", "?" + p.toString() + location.hash);
      };

      form.addEventListener("input", apply);
      form.addEventListener("submit", (e) => e.preventDefault());
      customElements.whenDefined("lanyard-badge").then(apply);

      const slug = () => (values().name || "badge").toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "") || "badge";
      form.querySelector('[data-action="download"]').addEventListener("click", async () => {
        await badge.download("front", `pramaan-${slug()}-front.png`);
        await badge.download("back", `pramaan-${slug()}-back.png`);
        status.textContent = "Downloaded the front and back.";
      });
      form.querySelector('[data-action="share"]').addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(location.href);
          status.textContent = "Link copied. Anyone with it sees this badge.";
        } catch {
          status.textContent = location.href;
        }
      });
    })();
  </script>
</Fragment>
</Base>

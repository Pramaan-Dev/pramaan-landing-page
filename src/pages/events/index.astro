---
import Base from '../../layouts/Base.astro';
import { events, split, fmtWhen, FORMAT } from '../../lib/events.mjs';
import { coverOf } from '../../lib/blog.mjs';
const { upcoming, past } = split(await events());
---
<Base title="Events | Pramaan" description="Live demos, talks and meetups from the Pramaan team." canonical="https://www.pramaan.dev/events" footerProps={{ variant: 'catalogue', count: '3510', countLabel: 'Superpowers', eyebrow: 'find', tools: ['ui-builder', 'ui-inspiration'] }}>
  <Fragment slot="head">
    <link rel="stylesheet" href="/catalogue.css" />
    <link rel="stylesheet" href="/components/ticket-stub-footer.css" />
    <script is:inline src="/components/ticket-stub-footer.js" defer></script>
  </Fragment>
  <main>
    <section class="cat-hero">
      <div class="container cat-hero__inner">
        <h1 class="display">Events</h1>
        <p class="lead">Live demos, talks and meetups. Come and watch an agent get real work done, and ask us anything.</p>
      </div>
    </section>
    <div class="container">
      <div class="posts">
        <h2 class="ev-head">Upcoming</h2>
        {upcoming.length === 0 && <p class="caption">Nothing scheduled right now. Check back soon.</p>}
        {upcoming.length > 0 && (
          <div class="posts__grid">
            {upcoming.map((e) => (
              <a class="pcard" href={`/events/${e.id}`}>
                <div class={`pcard__cover cover cover--${coverOf(e.id)}`} aria-hidden="true"></div>
                <span class="pcard__meta">{FORMAT[e.data.format]} | {fmtWhen(e)}</span>
                <b class="pcard__title">{e.data.title}</b>
                <span class="pcard__sub">{e.data.description}</span>
                <span class="pcard__more">Details</span>
              </a>
            ))}
          </div>
        )}
        {past.length > 0 && (
          <>
            <h2 class="ev-head">Past</h2>
            <div class="posts__grid">
              {past.map((e) => (
                <a class="pcard" href={`/events/${e.id}`}>
                  <span class="pcard__meta">{FORMAT[e.data.format]} | {fmtWhen(e)}</span>
                  <b class="pcard__title">{e.data.title}</b>
                  <span class="pcard__more">Details</span>
                </a>
              ))}
            </div>
          </>
        )}
      </div>
    </div>
  </main>
</Base>

---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ViewToggle from '../../components/ViewToggle.astro';
import AgentView from '../../components/AgentView.astro';
import { events, split, isPast, fmtWhen, FORMAT, eventMd } from '../../lib/events.mjs';
import { coverOf } from '../../lib/blog.mjs';

export async function getStaticPaths() {
  const all = await events();
  const { upcoming, past } = split(all);
  // other events: upcoming first, then recent past, never this one
  return all.map((e) => ({ params: { slug: e.id }, props: { e, others: [...upcoming, ...past].filter((x) => x !== e).slice(0, 3) } }));
}
const { e, others } = Astro.props;
const initials = (n) => n.split(/\s+/).map((w) => w[0]).slice(0, 2).join('').toUpperCase();
const { Content } = await render(e);
const url = `https://www.pramaan.dev/events/${e.id}`;
const past = isPast(e);
const ld = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: e.data.title,
  description: e.data.description,
  startDate: e.data.start.toISOString(),
  ...(e.data.end && { endDate: e.data.end.toISOString() }),
  eventAttendanceMode: { online: 'https://schema.org/OnlineEventAttendanceMode', 'in-person': 'https://schema.org/OfflineEventAttendanceMode', hybrid: 'https://schema.org/MixedEventAttendanceMode' }[e.data.format],
  location: e.data.format === 'online' ? { '@type': 'VirtualLocation', url: e.data.registerUrl || url } : { '@type': 'Place', name: e.data.location, address: e.data.location },
  organizer: { '@type': 'Organization', name: e.data.host, url: 'https://www.pramaan.dev' },
  url,
}).replace(/</g, '\\u003c');
---
<Base title={`${e.data.title} | Pramaan events`} description={e.data.description} canonical={url} footerProps={{ variant: 'catalogue', count: '3510', countLabel: 'Superpowers', eyebrow: 'find', tools: ['ui-builder', 'ui-inspiration'] }}>
  <Fragment slot="head">
    <meta property="og:type" content="website" />
    <meta property="og:title" content={e.data.title} />
    <meta property="og:description" content={e.data.description} />
    <meta property="og:url" content={url} />
    <script is:inline type="application/ld+json" set:html={ld}></script>
    <link rel="alternate" type="text/markdown" href={`${url}.md`} />
    <link rel="stylesheet" href="/catalogue.css" />
    <link rel="stylesheet" href="/components/ticket-stub-footer.css" />
    <script is:inline src="/components/ticket-stub-footer.js" defer></script>
  </Fragment>
  <main>
    <div class="container">
      <ViewToggle />
      <div data-human-view>
        <nav class="detail__crumbs" aria-label="Breadcrumb"><a href="/events">Events</a> / <span>{e.data.title}</span></nav>
        <section class="evx evx--top">
          <div class="evx__main">
            <span class="post__meta">{past ? 'Past event' : `${FORMAT[e.data.format]} event`}</span>
            <h1 class="evx__title">{e.data.title}</h1>
            <p class="evx__sub">{e.data.description}</p>
            {e.data.speakers.length > 0 && (
              <div class="evx__speakers">
                <span class="post__meta">Featuring</span>
                <ul>
                  {e.data.speakers.map((s) => (
                    <li>
                      {s.photo ? <img src={s.photo} alt="" width="48" height="48" loading="lazy" /> : <span class="evx__av" aria-hidden="true">{initials(s.name)}</span>}
                      <span><b>{s.name}</b><small>{s.role}</small></span>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
          <aside class="evx__card" aria-label="Event details">
            <dl>
              <div><dt>When</dt><dd>{fmtWhen(e)}</dd></div>
              <div><dt>Where</dt><dd>{e.data.location}</dd></div>
              <div><dt>Host</dt><dd>{e.data.host}</dd></div>
            </dl>
            {past
              ? <p class="caption">This event has ended.</p>
              : <>
                  {e.data.registerUrl && <a class="btn btn--blue" href={e.data.registerUrl}>Save my seat <span class="btn__arrow" aria-hidden="true">&#9656;</span></a>}
                  <a class="evx__cal" href={`/events/${e.id}.ics`} download>Add to calendar</a>
                </>}
          </aside>
        </section>
        <section class="evx evx--body">
          <article class="evx__main">
            <h2 class="evx__h2">About this event</h2>
            <div class="post__body"><Content /></div>
            <p class="evx__share"><span class="post__meta">Share</span>
              <a href={`https://x.com/intent/post?url=${encodeURIComponent(url)}&text=${encodeURIComponent(e.data.title)}`} rel="noopener" target="_blank">X</a>
              <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`} rel="noopener" target="_blank">LinkedIn</a>
            </p>
          </article>
          <aside class="evx__others">
            <h2 class="evx__side-h">Other events</h2>
            {others.map((o) => (
              <a class="pcard" href={`/events/${o.id}`}>
                <div class={`pcard__cover cover cover--${coverOf(o.id)}`} aria-hidden="true"></div>
                <b class="pcard__title">{o.data.title}</b>
                <span class="pcard__meta">{isPast(o) ? 'Past' : FORMAT[o.data.format]} | {fmtWhen(o)}</span>
              </a>
            ))}
            <a class="evx__all" href="/events">All events &rarr;</a>
          </aside>
        </section>
      </div>
      <AgentView md={eventMd(e)} url={url} />
    </div>
  </main>
</Base>

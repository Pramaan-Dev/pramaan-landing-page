---
import Base from '../layouts/Base.astro';
import { allResources, TYPE, AUDIENCE, fmtDay } from '../lib/resources.mjs';
import { coverOf } from '../lib/blog.mjs';
import { ROLE } from '../lib/roles.mjs';
const all = await allResources();
const [lead, ...more] = all;
const side = more.slice(0, 3);
// Only teams that have at least one resource get a checkbox
const teams = Object.keys(ROLE).filter((k) => all.some((r) => r.roles.includes(k)));
---
<Base title="Resources | Pramaan" description="Blog posts, events, ebooks, whitepapers and reports from the Pramaan team, for business teams and developers." canonical="https://www.pramaan.dev/resources" footerProps={{ variant: 'catalogue', count: '3510', countLabel: 'Superpowers', eyebrow: 'find', tools: ['ui-builder', 'ui-inspiration'] }}>
  <Fragment slot="head">
    <link rel="stylesheet" href="/catalogue.css" />
    <link rel="stylesheet" href="/components/ticket-stub-footer.css" />
    <script is:inline src="/components/ticket-stub-footer.js" defer></script>
  </Fragment>
  <main>
    <section class="cat-hero">
      <div class="container cat-hero__inner">
        <h1 class="display">Resources</h1>
        <p class="lead">Posts, events and guides on getting real work done with Pramaan, for business teams and developers.</p>
      </div>
    </section>
    <div class="container">
      {lead && (
        <section class="rfeat">
          <a class="rfeat__lead" href={lead.href}>
            <div class={`pcard__cover cover cover--${coverOf(lead.id)}`} aria-hidden="true"></div>
            <b class="rfeat__title">{lead.title}</b>
            <span class="pcard__sub">{lead.description}</span>
            <span class="pcard__meta"><span class="rtag">{TYPE[lead.type]}</span> {fmtDay(lead.date)}</span>
          </a>
          <div class="rfeat__list">
            {side.map((r) => (
              <a class="rrow" href={r.href}>
                <div class={`rrow__thumb cover cover--${coverOf(r.id)}`} aria-hidden="true"></div>
                <span><span class="pcard__meta">{TYPE[r.type]}</span><b>{r.title}</b></span>
              </a>
            ))}
          </div>
        </section>
      )}

      <section class="rlib" data-rlib>
        <div class="rfilters">
          <details class="rdd">
            <summary>Content type</summary>
            <div class="rdd__menu">
              {Object.entries(TYPE).map(([k, v]) => <label><input type="checkbox" name="type" value={k} /> {v}</label>)}
              <button type="button" class="rdd__reset" data-reset="type">Reset</button>
            </div>
          </details>
          <details class="rdd">
            <summary>Audience</summary>
            <div class="rdd__menu">
              {['business', 'developers'].map((k) => <label><input type="radio" name="aud" value={k} /> {AUDIENCE[k]}</label>)}
              <button type="button" class="rdd__reset" data-reset="aud">Reset</button>
            </div>
          </details>
          {teams.length > 0 && (
            <details class="rdd">
              <summary>Team</summary>
              <div class="rdd__menu">
                {teams.map((k) => <label><input type="checkbox" name="role" value={k} /> {ROLE[k]}</label>)}
                <button type="button" class="rdd__reset" data-reset="role">Reset</button>
              </div>
            </details>
          )}
          <button type="button" class="rfilters__reset" data-reset="all">Reset filters</button>
          <span class="rfilters__count" aria-live="polite">Showing <b data-shown>{all.length}</b> of <b>{all.length}</b></span>
        </div>
        <div class="rgrid">
          {all.map((r) => (
            <a class="pcard" href={r.href} data-type={r.type} data-aud={r.audience} data-roles={r.roles.join(' ')}>
              <div class={`pcard__cover cover cover--${coverOf(r.id)}`} aria-hidden="true"></div>
              <b class="pcard__title">{r.title}</b>
              <span class="pcard__meta"><span class="rtag">{TYPE[r.type]}</span> {r.note && `${r.note} | `}{fmtDay(r.date)}</span>
            </a>
          ))}
        </div>
        <p class="caption" data-none hidden>Nothing matches. <button type="button" class="rfilters__reset" data-reset="all">Reset filters</button></p>
      </section>
    </div>
  </main>
  <script is:inline>
    // Filters: content type (any ticked), audience ("everyone" matches both) and team (any ticked).
    // ?type=ebook and ?role=sales pre-tick one.
    (() => {
      const lib = document.querySelector('[data-rlib]');
      const cards = [...lib.querySelectorAll('.rgrid > a')];
      const apply = () => {
        const types = [...lib.querySelectorAll('input[name=type]:checked')].map((i) => i.value);
        const aud = lib.querySelector('input[name=aud]:checked')?.value;
        const roles = [...lib.querySelectorAll('input[name=role]:checked')].map((i) => i.value);
        let n = 0;
        for (const c of cards) {
          const mine = c.dataset.roles.split(' ');
          const ok = (!types.length || types.includes(c.dataset.type)) && (!aud || c.dataset.aud === aud || c.dataset.aud === 'everyone')
            && (!roles.length || roles.some((r) => mine.includes(r)));
          c.hidden = !ok; n += ok;
        }
        lib.querySelector('[data-shown]').textContent = n;
        lib.querySelector('[data-none]').hidden = n > 0;
      };
      lib.addEventListener('change', apply);
      lib.addEventListener('click', (e) => {
        const r = e.target.closest('[data-reset]'); if (!r) return;
        lib.querySelectorAll(r.dataset.reset === 'all' ? 'input' : `input[name=${r.dataset.reset}]`).forEach((i) => (i.checked = false));
        apply();
      });
      // close a filter menu when clicking elsewhere
      document.addEventListener('click', (e) => lib.querySelectorAll('details[open]').forEach((d) => { if (!d.contains(e.target)) d.open = false; }));
      const q = new URLSearchParams(location.search);
      for (const name of ['type', 'role']) {
        const want = q.get(name);
        const i = want && lib.querySelector(`input[name=${name}][value="${CSS.escape(want)}"]`);
        if (i) { i.checked = true; apply(); }
      }
    })();
  </script>
</Base>

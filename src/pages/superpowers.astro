---
import Base from '../layouts/Base.astro';
import { toCards, groupsHtml, sideHtml } from '../../public/catalogue-render.js';
import data from '../../public/data/superpowers.json';
const groups = groupsHtml(data, toCards('superpowers', data));
const cats = sideHtml(data);
---
<Base title={"Superpowers | Pramaan"} description={"Every superpower Pramaan can rent you per use: search, data, social, messaging, payments, AI and more, each routed to the cheapest source that can do the job."} nav="site" current="superpowers" bodyAttrs={{"data-kind":"superpowers"}} footerProps={{"variant":"catalogue","count":"3510","countLabel":"Superpowers","eyebrow":"find","tools":["ui-builder","ui-inspiration"]}}>
<Fragment slot="head">
<link rel="stylesheet" href="/catalogue.css" />
  <link rel="alternate" type="text/markdown" href="/catalogue/index.md" title="Full catalogue" />
  <link rel="stylesheet" href="/components/ticket-stub-footer.css" />
  <script is:inline src="/components/ticket-stub-footer.js" defer></script>
</Fragment>


  

  <main>
    <section class="cat-hero">
      <div class="wash wash--hero-a" aria-hidden="true"></div>
      <div class="wash wash--hero-b" aria-hidden="true"></div>
      <div class="container cat-hero__inner">
        <span class="tag"><span class="tag__dot"></span>Superpowers</span>
        <h1 class="display">Superpowers on demand.</h1>
        <p class="lead">Each superpower is one thing Pramaan can do for you: find a company, read a page, send a text, take a payment. Rent any of them per use. Pramaan picks the cheapest source that can do the job.</p>
        <label class="cat-search">
          <span aria-hidden="true">&#9906;</span>
          <input type="search" placeholder="Search superpowers, e.g. TikTok, invoice, weather" aria-label="Search superpowers" data-short="Search superpowers" data-search />
        </label>
      </div>
    </section>

    <div class="container cat-layout">
      <aside class="cat-side" aria-label="Categories">
        <p class="eyebrow cat-side__title">Categories</p>
        <ul data-cats><Fragment set:html={cats} /></ul>
      </aside>
      <div data-groups><Fragment set:html={groups} /></div>
    </div>
  </main>

  <div class="panel-scrim" hidden data-scrim></div>
  <aside class="panel" hidden data-panel role="dialog" aria-modal="true" aria-label="Superpower details">
    <div class="panel__top">
      <span class="caption">Superpowers</span>
      <button type="button" class="panel__close" aria-label="Close" data-close>&times;</button>
    </div>
    <div class="panel__body" data-panel-body></div>
  </aside>

  
<Fragment slot="foot">
<script is:inline type="module" src="/catalogue.js"></script>
</Fragment>
</Base>

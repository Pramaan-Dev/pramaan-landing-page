---
import Base from '../layouts/Base.astro';
---
<Base title={"UI inspiration | Pramaan"} description={"Over a thousand real website designs to start from. Pick one and open it in the free UI builder with its colours, fonts and corners already applied."} nav="site" footerProps={{"variant":"catalogue","count":"1283","countLabel":"Designs","eyebrow":"research","tools":["ui-builder","ui-inspiration"]}}>
<Fragment slot="head">
<link rel="stylesheet" href="/catalogue.css" />
  <link rel="stylesheet" href="/components/ticket-stub-footer.css" />
  <script is:inline src="/components/ticket-stub-footer.js" defer></script>
  <style is:inline>
    .insp-bar { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; padding-top: 32px; border-top: 1px solid var(--color-ash); }
    .insp-bar > button:not(.ddt) { height: 36px; padding: 0 12px; border: 1px solid var(--color-ash); border-radius: var(--radius-pills); background: rgba(255,255,255,.6); font: inherit; font-size: var(--text-body-sm); color: inherit; cursor: pointer; }
    .insp-bar > button[aria-pressed="true"] { background: var(--color-off-black); border-color: var(--color-off-black); color: #fff; }
    .insp-count { margin-left: auto; font-size: var(--text-body-sm); color: var(--color-smoke); }
    .insp-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 16px; padding: 24px 0 32px; }
    .insp-card { display: flex; flex-direction: column; overflow: hidden; background: rgba(255,255,255,.45); border: 1px solid var(--color-ash); border-radius: 24px; }
    .insp-shot { display: block; aspect-ratio: 16 / 10; overflow: hidden; background: var(--color-ash); }
    .insp-shot img { width: 100%; height: 100%; object-fit: cover; object-position: top; display: block; }
    .insp-body { display: flex; flex-direction: column; gap: 10px; padding: 16px 20px 20px; flex: 1; }
    .insp-body b { font-family: var(--font-serif); font-weight: 400; font-size: 22px; letter-spacing: -0.02em; line-height: 1.2; }
    .insp-body small { color: var(--color-smoke); }
    .insp-body p { margin: 0; flex: 1; font-size: var(--text-body-sm); color: var(--color-graphite); }
    .insp-sw { display: flex; gap: 4px; }
    .insp-sw i { width: 18px; height: 18px; border-radius: 50%; border: 1px solid rgba(0,0,0,.12); }
    .insp-go { align-self: flex-start; margin-top: 4px; }
    .insp-more { display: flex; justify-content: center; padding-bottom: 120px; }
  </style>
</Fragment>


  

  <main>
    <section class="cat-hero">
      <div class="wash wash--hero-a" aria-hidden="true"></div>
      <div class="wash wash--hero-b" aria-hidden="true"></div>
      <div class="container cat-hero__inner">
        <span class="tag"><span class="tag__dot"></span>UI inspiration</span>
        <h1 class="display">Start from a real design.</h1>
        <p class="lead">Styles taken from real websites: colours, fonts, spacing and corners. Pick one and open it in the free <a href="/ui-builder">UI builder</a>, already applied, then copy the code or the prompt for your coding tool.</p>
        <label class="cat-search">
          <span aria-hidden="true">&#9906;</span>
          <input type="search" placeholder="Search designs, e.g. fintech, rounded blue, dark" aria-label="Search designs" data-short="Search designs" data-q />
        </label>
      </div>
    </section>

    <div class="container">
      <div class="insp-bar" data-bar></div>
      <div class="insp-grid" data-grid><p>Loading designs…</p></div>
      <div class="insp-more"><button type="button" class="btn btn--ghost" data-more hidden>Show more</button></div>
    </div>
  </main>

  
<Fragment slot="foot">
<!-- Design library: images, style guides and the index live on the designs host (same base as ui-builder.html). -->
  <script is:inline>const DB = 'https://design.pramaan.dev/';</script>
  <script is:inline src="https://design.pramaan.dev/_gallery.js"></script>
  <script is:inline src="/dropdown.js"></script>
  <script is:inline src="/ui-inspiration.js"></script>
</Fragment>
</Base>

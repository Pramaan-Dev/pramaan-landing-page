---
// One share image per blog post, event and guide, 1200x630, screenshotted to public/og/<kind>/<slug>.png by
// scripts/og-images.mjs. Built from the home page's pieces: hero washes, logo, serif title, mono labels, and one
// site element per type. Only exists when OG_PAGES=1 (the script's dev server), so it never ships.
import { posts } from '../../../lib/blog.mjs';
import { events, isPast, FORMAT } from '../../../lib/events.mjs';
import { guides, TYPE, AUDIENCE } from '../../../lib/resources.mjs';

export async function getStaticPaths() {
  if (process.env.OG_PAGES !== '1') return [];
  const all = [
    ...(await posts()).map((x) => ['blog', x]),
    ...(await events()).map((x) => ['events', x]),
    ...(await guides()).map((x) => ['guides', x]),
  ];
  return all.map(([kind, entry]) => ({ params: { kind, slug: entry.id }, props: { kind, entry } }));
}
const { kind, entry } = Astro.props;
const d = entry.data;
const nb = (t) => t.replace(/-/g, '‑'); // keep go-to-market on one line
const short = (t) => t.split(': ')[0];
const london = (o) => d.start.toLocaleString('en-GB', { timeZone: 'Europe/London', ...o });
// [left glow, right glow] per kind, from the home page washes.
const W = kind === 'blog' && d.og.steps ? ['167,252,205', '160,181,235'] // how-tos: mint
  : { blog: ['255,148,115', '160,181,235'], events: ['255,148,115', '236,218,152'], guides: ['236,218,152', '167,252,205'] }[kind];
const past = kind === 'events' && isPast(entry);
const replay = past && d.replay;
const tag = { blog: d.og?.tag ?? 'Blog', events: replay ? 'Replay' : past ? 'Past event' : 'Live event', guides: TYPE[d.type] }[kind];
const title = kind === 'guides' ? short(d.title) : d.title;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="robots" content="noindex" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500&family=JetBrains+Mono:wght@400;500&family=Newsreader:opsz,wght@6..72,400&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/styles.css" />
  <style>
    body { margin: 0; }
    .og { width: 1200px; height: 630px; position: relative; overflow: hidden; display: grid; grid-template-columns: 1fr 460px; gap: 48px; align-items: center; padding: 0 80px; box-sizing: border-box; background: var(--color-parchment); color: var(--color-off-black); font-family: var(--font-mono); }
    .og .wash { filter: blur(80px); }
    .og__wa { width: 620px; height: 480px; left: -160px; bottom: -200px; background: radial-gradient(circle, rgba(var(--a),.85), rgba(var(--b),.6)); opacity: .75; }
    .og__wb { width: 560px; height: 520px; right: -120px; top: -80px; background: radial-gradient(circle, rgba(var(--b),.85), rgba(var(--a),.5)); opacity: .8; }
    .og__l, .og__r { position: relative; z-index: 1; }
    .og__logo { position: absolute; top: 56px; left: 80px; z-index: 1; display: flex; align-items: center; gap: 12px; }
    .og__logo .logo__mark { width: 40px; height: 40px; }
    .og__logo b { font-family: var(--font-serif); font-weight: 400; font-size: 32px; letter-spacing: -0.02em; }
    .og__tag { position: absolute; top: 60px; right: 80px; z-index: 1; display: inline-flex; align-items: center; gap: 8px; padding: 8px 16px; border: 1px solid var(--color-ash); border-radius: 999px; background: rgba(246,243,241,.7); font-size: 16px; text-transform: uppercase; }
    .og__tag i { width: 10px; height: 10px; border-radius: 50%; border: 2px solid var(--color-off-black); background: rgb(var(--a)); }
    .og__t { font-family: var(--font-serif); font-weight: 400; font-size: 64px; line-height: 1.03; letter-spacing: -0.035em; margin: 40px 0 0; }
    .og__line { margin: 24px 0 0; max-width: 500px; font-size: 19px; line-height: 1.45; color: var(--color-graphite); }
    .og__small { font-size: 14px; text-transform: uppercase; color: var(--color-smoke); }
    /* Ask-to-done flow (home "From ask to done") */
    .og__flow { display: flex; flex-direction: column; align-items: center; gap: 10px; }
    .og__step { width: 100%; box-sizing: border-box; padding: 18px 22px; border: 1px solid var(--color-ash); border-radius: 16px; background: rgba(246,243,241,.92); display: flex; flex-direction: column; gap: 6px; }
    .og__step span { font-size: 19px; line-height: 1.3; }
    .og__step .og__small { font-size: 14px; }
    .og__step--last { border-color: var(--color-off-black); }
    .og__then { padding: 2px 12px; border: 1px solid var(--color-ash); border-radius: 999px; background: var(--color-parchment); font-size: 12px; text-transform: uppercase; color: var(--color-graphite); }
    .og__more { padding: 10px 20px; border-radius: 999px; background: var(--color-off-black); color: var(--color-parchment); font-size: 15px; text-transform: uppercase; }
    /* Replay: a still from the video when there is one, the glow otherwise */
    .og__video { aspect-ratio: 4 / 3; border-radius: 24px; border: 1px solid var(--color-ash); background: rgba(246,243,241,.6) center / cover; position: relative; display: grid; place-items: center; overflow: hidden; }
    .og__video::before { content: ''; position: absolute; inset: 20% 15%; border-radius: 50%; background: radial-gradient(circle, rgba(167,252,205,.9), rgba(160,181,235,.5)); filter: blur(40px); }
    .og__video.has-still::before { inset: 0; border-radius: 0; filter: none; background: linear-gradient(to top, rgba(36,36,36,.45), transparent 45%); }
    .og__play { position: relative; width: 96px; height: 96px; border-radius: 50%; background: var(--color-off-black); display: grid; place-items: center; }
    .og__play::before { content: ''; border-left: 30px solid var(--color-parchment); border-top: 18px solid transparent; border-bottom: 18px solid transparent; margin-left: 8px; }
    .og__len { position: absolute; left: 20px; bottom: 18px; font-size: 15px; text-transform: uppercase; }
    .has-still .og__len { color: #fff; }
    /* Command box (home hero "Just ask") */
    .og__install { display: flex; flex-direction: column; gap: 14px; align-items: center; }
    .og__box { width: 100%; box-sizing: border-box; padding: 18px 24px; border: 1px solid var(--color-ash); border-radius: 20px; background: rgba(246,243,241,.95); font-size: 18px; line-height: 1.45; }
    .og__box em { font-style: normal; color: var(--color-smoke); margin-right: 8px; }
    /* Event card (home "Needs your OK") */
    .og__ok { padding: 30px; border-radius: 24px; background: var(--color-periwinkle-mist); display: flex; flex-direction: column; gap: 14px; }
    .og__ok small { font-size: 14px; text-transform: uppercase; letter-spacing: .1em; }
    .og__ok b { font-family: var(--font-serif); font-weight: 400; font-size: 38px; letter-spacing: -0.02em; line-height: 1.1; }
    .og__ok p { margin: 0; padding: 10px 0; border-top: 1px dashed rgba(36,36,36,.3); font-size: 17px; }
    .og__btn { align-self: flex-start; padding: 10px 18px; border-radius: 999px; background: var(--color-lake-blue); color: #fff; font-size: 14px; text-transform: uppercase; }
    /* Book: spine, page block, floor shadow */
    .og__bookwrap { display: flex; flex-direction: column; align-items: center; gap: 28px; margin-top: 40px; }
    .og__book { width: 290px; height: 380px; box-sizing: border-box; border-radius: 4px 14px 14px 4px; padding: 26px 24px 24px 34px; display: flex; flex-direction: column; justify-content: space-between;
      background: radial-gradient(120% 80% at 90% 10%, rgba(255,148,115,.55), transparent 55%), radial-gradient(90% 70% at 10% 100%, rgba(160,181,235,.6), transparent 60%), linear-gradient(165deg, var(--color-gold), var(--color-mint));
      box-shadow: inset 14px 0 0 rgba(36,36,36,.08), inset 15px 0 0 rgba(255,255,255,.5), 6px 0 0 -1px #fbfaf8, 7px 0 0 -1px var(--color-ash), 12px 0 0 -2px #fbfaf8, 13px 0 0 -2px var(--color-ash), 0 30px 50px -10px rgba(36,36,36,.28);
      transform: perspective(1200px) rotateY(-14deg) rotate(-2deg); }
    .og__book .logo__mark { width: 30px; height: 30px; }
    .og__book b { font-family: var(--font-serif); font-weight: 400; font-size: 46px; line-height: .98; letter-spacing: -0.03em; }
    .og__book small { font-size: 12px; text-transform: uppercase; letter-spacing: .08em; }
  </style>
</head>
<body>
  <div class="og" style={`--a:${W[0]};--b:${W[1]}`}>
    <div class="wash og__wa"></div><div class="wash og__wb"></div>
    <span class="og__logo"><span class="logo__mark"></span><b>pramaan</b></span>
    <span class="og__tag"><i></i>{tag}</span>
    <div class="og__l">
      <h1 class="og__t">{nb(title)}</h1>
      {kind === 'guides' && <p class="og__line">{d.description}</p>}
    </div>
    <div class="og__r">
      {kind === 'blog' && (d.og.steps ? (
        <div class="og__flow">
          {d.og.steps.slice(0, 2).map((s, i) => <><div class="og__step"><span class="og__small">Step {String(i + 1).padStart(2, '0')}</span><span>{s}</span></div><span class="og__then">Then</span></>)}
          {d.og.steps.length > 2 ? <span class="og__more">+{d.og.steps.length - 2} more steps</span> : <span class="og__more">Done</span>}
        </div>
      ) : d.og.code ? (
        <div class="og__install">
          <span class="og__small">Try it</span>
          <div class="og__box"><em>$</em>{d.og.code.split(' --')[0]}{d.og.code.split(' --').slice(1).map((p) => <><br />&nbsp;&nbsp;--{p}</>)}</div>
          {d.og.note && <span class="og__small">{d.og.note}</span>}
        </div>
      ) : d.og.ask ? (
        <div class="og__flow">
          <div class="og__step"><span class="og__small">You ask</span><span>{d.og.ask}</span></div>
          <span class="og__then">Then</span>
          <div class="og__step og__step--last"><span class="og__small">Done, with proof</span><span>&#10003; {d.og.done ?? 'Done'}</span></div>
        </div>
      ) : (
        <div class="og__flow"><div class="og__step og__step--last"><span class="og__small">In this post</span><span>{d.description}</span></div></div>
      ))}
      {replay && (
        <div class={`og__video${d.replay.still ? ' has-still' : ''}`} style={d.replay.still ? `background-image:url(${d.replay.still})` : undefined}>
          <span class="og__play"></span>{d.replay.length && <span class="og__len">{d.replay.length}</span>}
        </div>
      )}
      {kind === 'events' && !replay && (
        <div class="og__ok">
          <small>{FORMAT[d.format]} · {AUDIENCE[d.audience]}</small>
          <b>{london({ weekday: 'short', day: 'numeric', month: 'short' })}</b>
          <p>{london({ hour: '2-digit', minute: '2-digit' })} London{d.format !== 'online' ? ` · ${d.location.split(',')[0]}` : ''}</p>
          {!past && d.registerUrl && <span class="og__btn">Save my seat</span>}
        </div>
      )}
      {kind === 'guides' && (
        <div class="og__bookwrap">
          <div class="og__book"><span class="logo__mark"></span><b>{short(d.title)}</b><small>Pramaan {TYPE[d.type].toLowerCase()}</small></div>
          {d.pages && <span class="og__small">{d.pages} pages</span>}
        </div>
      )}
    </div>
  </div>
</body>
</html>

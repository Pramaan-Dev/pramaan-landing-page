{
  "framework": "astro",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "redirects": [
    { "source": "/sitemap.xml", "destination": "/sitemap-index.xml", "permanent": true },
    { "source": "/security.txt", "destination": "/.well-known/security.txt", "permanent": true },
    { "source": "/legal{/}?", "destination": "/legal/terms", "permanent": false }
  ],
  "rewrites": [
    { "source": "/SKILL.md", "destination": "/skill.md" },
    { "source": "/skills/:slug/SKILL.md", "destination": "/skills/:slug/skill.md" }
  ],
  "headers": [
    { "source": "/", "headers": [{ "key": "Link", "value": "</.well-known/ai-catalog.json>; rel=\"ai-catalog\", </skill.md>; rel=\"alternate\"; type=\"text/markdown\"" }] },
    { "source": "/(.*)\\.md", "headers": [{ "key": "Content-Type", "value": "text/markdown; charset=utf-8" }] },
    { "source": "/.well-known/microsoft-identity-association.json", "headers": [{ "key": "Content-Type", "value": "application/json" }] },
    { "source": "/(.*)\\.txt", "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }] }
  ]
}
